<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AveroNova.App.UI.Views.Customers.CustomerDetailsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:forms="clr-namespace:AveroNova.App.UI.Controls.Forms"
    xmlns:state="clr-namespace:AveroNova.App.UI.Controls.State"
    xmlns:vm="clr-namespace:AveroNova.App.UI.ViewModels"
    x:DataType="vm:CustomerViewViewModel">
    <Grid RowDefinitions="Auto,*">
        <Border Padding="20,12" StrokeThickness="1">
            <Grid x:Name="HeaderBar" ColumnDefinitions="*,Auto" ColumnSpacing="12" RowSpacing="8" SizeChanged="OnHeaderSizeChanged">
                <HorizontalStackLayout x:Name="HeaderTitle" Spacing="8" VerticalOptions="Center" HorizontalOptions="Start">
                    <Button Text="{StaticResource IconBack}" Style="{StaticResource GhostButton}" Padding="0" WidthRequest="40" HeightRequest="40" MinimumWidthRequest="40" Command="{Binding BackCommand}" SemanticProperties.Description="Back to customers" />
                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                        <Label Text="Customer Profile" FontSize="18" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding DisplayName}" FontSize="12" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
                <HorizontalStackLayout x:Name="HeaderActions" Grid.Column="1" Spacing="8" VerticalOptions="Center" HorizontalOptions="End">
                    <Button Text="Edit Customer" Style="{StaticResource SmallButton}" HeightRequest="40" MinimumWidthRequest="120" Padding="16,0" Command="{Binding EditCommand}" IsVisible="{Binding ShowEditButton}" IsEnabled="{Binding IsDeleting, Converter={StaticResource InverseBoolConverter}}" />
                    <Grid HeightRequest="40" IsVisible="{Binding ShowDeleteButton}">
                        <Button Text="{Binding DeleteButtonText}" Style="{StaticResource SmallButton}" HeightRequest="40" MinimumWidthRequest="100" Padding="14,0" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanPressDelete}" />
                        <ActivityIndicator IsVisible="{Binding IsDeleting}" IsRunning="{Binding IsDeleting}" WidthRequest="14" HeightRequest="14" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,8,0" InputTransparent="True" />
                    </Grid>
                </HorizontalStackLayout>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <state:LoadingView IsVisible="{Binding ShowLoading}" Message="Loading customer..." />
            <state:ErrorView x:Name="ErrorState" IsVisible="{Binding ShowError}" Title="Unable to load customer" Message="Please try again." />
            <ScrollView IsVisible="{Binding ShowContent}">
                <VerticalStackLayout Padding="20,16,20,24" Spacing="18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Customer Details" FontSize="16" FontAttributes="Bold" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource AppCard}" Padding="16">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                <Border WidthRequest="60" HeightRequest="60" BackgroundColor="{StaticResource Primary50}" StrokeThickness="0" StrokeShape="RoundRectangle 30" VerticalOptions="Center">
                                    <Label Text="{Binding DisplayInitials}" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding DisplayName}" FontSize="18" FontAttributes="Bold" />
                                    <Label Text="{Binding DisplayStatus}" FontSize="13" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Contact &amp; Account Information" FontSize="16" FontAttributes="Bold" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource ReviewCard}">
                            <VerticalStackLayout Spacing="12">
                                <forms:ReviewFieldRow LabelText="Customer Name" ValueText="{Binding DisplayName}" IsInline="{Binding IsInlineLayout}" />
                                <forms:ReviewFieldRow LabelText="Mobile Number" ValueText="{Binding DisplayMobile}" IsInline="{Binding IsInlineLayout}" />
                                <forms:ReviewFieldRow LabelText="Email" ValueText="{Binding DisplayEmail}" IsInline="{Binding IsInlineLayout}" />
                                <forms:ReviewFieldRow LabelText="Address" ValueText="{Binding DisplayAddress}" IsInline="{Binding IsInlineLayout}" />
                                <forms:ReviewFieldRow LabelText="City" ValueText="{Binding DisplayCity}" IsInline="{Binding IsInlineLayout}" />
                                <forms:ReviewFieldRow LabelText="State" ValueText="{Binding DisplayState}" IsInline="{Binding IsInlineLayout}" />
                                <forms:ReviewFieldRow LabelText="Country" ValueText="{Binding DisplayCountry}" IsInline="{Binding IsInlineLayout}" />
                                <forms:ReviewFieldRow LabelText="PIN / ZIP" ValueText="{Binding DisplayPinCode}" IsInline="{Binding IsInlineLayout}" />
                                <forms:ReviewFieldRow LabelText="Tax Number" ValueText="{Binding DisplayTaxNumber}" IsInline="{Binding IsInlineLayout}" />
                                <forms:ReviewFieldRow LabelText="Notes" ValueText="{Binding DisplayNotes}" IsInline="{Binding IsInlineLayout}" />
                                <forms:ReviewFieldRow LabelText="Status" ValueText="{Binding DisplayStatus}" IsInline="{Binding IsInlineLayout}" />
                                <forms:ReviewFieldRow LabelText="Created Date" ValueText="{Binding DisplayCreated}" IsInline="{Binding IsInlineLayout}" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentView>
