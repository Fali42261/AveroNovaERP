<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AveroNova.App.UI.Views.Customers.CustomerDetailsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:forms="clr-namespace:AveroNova.App.UI.Controls.Forms"
    xmlns:state="clr-namespace:AveroNova.App.UI.Controls.State"
    xmlns:vm="clr-namespace:AveroNova.App.UI.ViewModels"
    x:DataType="vm:CustomerViewViewModel">

    <Grid x:Name="Root" RowDefinitions="Auto,*" SizeChanged="OnRootSizeChanged">

        <!-- ── Header bar (matches ProductDetailsView pattern) ── -->
        <Border Padding="20,14"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"
                StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Text="{StaticResource IconBack}"
                        Style="{StaticResource GhostButton}"
                        Padding="0" WidthRequest="40" HeightRequest="40"
                        Command="{Binding BackCommand}"
                        SemanticProperties.Description="Back to customers" />
                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                    <Label Text="Customer Profile"
                           FontSize="18" FontAttributes="Bold"
                           LineBreakMode="TailTruncation" MaxLines="1" />
                    <Label Text="{Binding DisplayName}"
                           FontSize="12"
                           LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
                <HorizontalStackLayout Grid.Column="2" Spacing="8"
                                       VerticalOptions="Center" HorizontalOptions="End">
                    <Button Text="Edit Customer"
                            Style="{StaticResource SmallButton}"
                            HeightRequest="40" MinimumWidthRequest="120" Padding="16,0"
                            Command="{Binding EditCommand}"
                            IsVisible="{Binding ShowEditButton}"
                            IsEnabled="{Binding IsDeleting, Converter={StaticResource InverseBoolConverter}}" />
                    <Grid HeightRequest="40" IsVisible="{Binding ShowDeleteButton}">
                        <Button Text="{Binding DeleteButtonText}"
                                Style="{StaticResource DangerButton}"
                                HeightRequest="40" MinimumWidthRequest="100" Padding="14,0"
                                Command="{Binding DeleteCommand}"
                                IsEnabled="{Binding CanPressDelete}" />
                        <ActivityIndicator IsVisible="{Binding IsDeleting}" IsRunning="{Binding IsDeleting}"
                                           WidthRequest="14" HeightRequest="14"
                                           HorizontalOptions="End" VerticalOptions="Center"
                                           Margin="0,0,8,0" InputTransparent="True" />
                    </Grid>
                </HorizontalStackLayout>
            </Grid>
        </Border>

        <!-- ── Body ── -->
        <Grid Grid.Row="1">
            <state:LoadingView IsVisible="{Binding ShowLoading}" Message="Loading customer..." />
            <state:ErrorView x:Name="ErrorState"
                             IsVisible="{Binding ShowError}"
                             Title="Unable to load customer"
                             Message="Please try again." />

            <ScrollView IsVisible="{Binding ShowContent}">
                <VerticalStackLayout Padding="20,16,20,24" Spacing="18">

                    <!-- Avatar + name card -->
                    <Border Style="{StaticResource AppCard}" Padding="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Border WidthRequest="60" HeightRequest="60"
                                    BackgroundColor="{StaticResource Primary50}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 30"
                                    VerticalOptions="Center">
                                <Label Text="{Binding DisplayInitials}"
                                       FontSize="22" FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryColor}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding DisplayName}"
                                       FontSize="18" FontAttributes="Bold"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="{Binding DisplayStatus}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Customer Details section (ReadOnlyFieldCard grid — same as Product/Company) -->
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Customer Details" Style="{StaticResource SectionTitle}" />
                        <Grid x:Name="CustomerFieldsGrid"
                              ColumnDefinitions="*,*,*"
                              ColumnSpacing="16" RowSpacing="16">
                            <forms:ReadOnlyFieldCard LabelText="Customer Name"    ValueText="{Binding DisplayName}" />
                            <forms:ReadOnlyFieldCard Grid.Column="1" LabelText="Mobile Number" ValueText="{Binding DisplayMobile}" />
                            <forms:ReadOnlyFieldCard Grid.Column="2" LabelText="Email"          ValueText="{Binding DisplayEmail}" />
                            <forms:ReadOnlyFieldCard Grid.Row="1"              LabelText="Tax Number"     ValueText="{Binding DisplayTaxNumber}" />
                            <forms:ReadOnlyFieldCard Grid.Row="1" Grid.Column="1" LabelText="Status"       ValueText="{Binding DisplayStatus}" />
                            <forms:ReadOnlyFieldCard Grid.Row="1" Grid.Column="2" LabelText="Created Date" ValueText="{Binding DisplayCreated}" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Address section -->
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Address" Style="{StaticResource SectionTitle}" />
                        <Grid x:Name="AddressFieldsGrid"
                              ColumnDefinitions="*,*,*"
                              ColumnSpacing="16" RowSpacing="16">
                            <forms:ReadOnlyFieldCard LabelText="Address"   ValueText="{Binding DisplayAddress}" />
                            <forms:ReadOnlyFieldCard Grid.Column="1" LabelText="City"      ValueText="{Binding DisplayCity}" />
                            <forms:ReadOnlyFieldCard Grid.Column="2" LabelText="State"     ValueText="{Binding DisplayState}" />
                            <forms:ReadOnlyFieldCard Grid.Row="1"              LabelText="Country"   ValueText="{Binding DisplayCountry}" />
                            <forms:ReadOnlyFieldCard Grid.Row="1" Grid.Column="1" LabelText="PIN / ZIP" ValueText="{Binding DisplayPinCode}" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Notes section -->
                    <VerticalStackLayout Spacing="12"
                                         IsVisible="{Binding DisplayNotes,
                                             Converter={StaticResource StringNotEmptyConverter}}">
                        <Label Text="Notes" Style="{StaticResource SectionTitle}" />
                        <forms:ReadOnlyFieldCard LabelText="Notes" ValueText="{Binding DisplayNotes}"
                                                 IsMultiline="True" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentView>
