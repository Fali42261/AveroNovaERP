<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AveroNova.App.UI.Views.Layout.AppSidebarView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    HorizontalOptions="Fill"
    VerticalOptions="Fill">

    <Border
        Style="{StaticResource SidebarShell}"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">
        <Grid
            ColumnDefinitions="*,1"
            RowDefinitions="Auto,*"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            IsClippedToBounds="True">

            <Grid
                x:Name="BrandHeader"
                Padding="16,14,16,12"
                ColumnDefinitions="42,*"
                ColumnSpacing="10"
                VerticalOptions="Start"
                MinimumHeightRequest="64">

                <Border
                    x:Name="BrandLogo"
                    WidthRequest="42"
                    HeightRequest="42"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 8"
                    VerticalOptions="Center"
                    HorizontalOptions="Start">
                    <Label
                        Text="AN"
                        FontFamily="OpenSansSemibold"
                        FontSize="15"
                        TextColor="{StaticResource White}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />
                </Border>

                <VerticalStackLayout
                    x:Name="BrandText"
                    Grid.Column="1"
                    Spacing="0"
                    VerticalOptions="Center">
                    <Label
                        Text="AveroNova"
                        Style="{StaticResource SidebarBrand}" />
                    <Label
                        Text="ERP System"
                        Style="{StaticResource SidebarBrandSubtitle}" />
                </VerticalStackLayout>
            </Grid>

            <BoxView
                HeightRequest="1"
                VerticalOptions="End"
                Color="{AppThemeBinding Light={StaticResource SidebarBorderLight}, Dark={StaticResource SidebarBorderDark}}" />

            <ScrollView
                x:Name="NavScroll"
                Grid.Row="1"
                Orientation="Vertical"
                VerticalScrollBarVisibility="Default"
                HorizontalScrollBarVisibility="Never"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                Padding="0">
                <VerticalStackLayout
                    x:Name="MenuHost"
                    Spacing="2"
                    Padding="8,8,8,16"
                    HorizontalOptions="Fill"
                    VerticalOptions="Start" />
            </ScrollView>

            <BoxView
                Grid.Column="1"
                Grid.RowSpan="2"
                WidthRequest="1"
                Color="{AppThemeBinding Light={StaticResource SidebarBorderLight}, Dark={StaticResource SidebarBorderDark}}" />
        </Grid>
    </Border>
</ContentView>
