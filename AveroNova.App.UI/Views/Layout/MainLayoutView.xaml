<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="AveroNova.App.UI.Views.Layout.MainLayoutView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:layout="clr-namespace:AveroNova.App.UI.Views.Layout"
    HorizontalOptions="Fill"
    VerticalOptions="Fill">

    <Grid
        x:Name="RootLayout"
        HorizontalOptions="Fill"
        VerticalOptions="Fill"
        IsClippedToBounds="True">

        <!-- ========================================================= -->
        <!-- DESKTOP                                                   -->
        <!-- ========================================================= -->

        <Grid
            x:Name="DesktopLayout"
            RowDefinitions="64,*"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            IsClippedToBounds="True"
            BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DesktopSidebarColumnDef" Width="256" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ContentView
                x:Name="DesktopSidebarColumn"
                Grid.Column="0"
                Grid.RowSpan="2"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">
                <layout:AppSidebarView
                    x:Name="DesktopSidebar"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />
            </ContentView>

            <Border
                Grid.Column="1"
                Grid.Row="0"
                Padding="12,0,20,0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"
                StrokeThickness="1">

                <Grid
                    ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                    VerticalOptions="Center"
                    ColumnSpacing="8">

                    <Button
                        x:Name="BtnDesktopMenu"
                        Text="{StaticResource IconMenu}"
                        Style="{StaticResource HeaderIconButton}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource SurfaceColorDark}}"
                        Clicked="OnDesktopMenuClicked"
                        AutomationId="HeaderSidebarToggle"
                        SemanticProperties.Description="Toggle navigation" />

                    <VerticalStackLayout
                        Grid.Column="1"
                        VerticalOptions="Center"
                        Spacing="2">

                        <Label
                            x:Name="LblPageTitle"
                            Text="Dashboard"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                        <Label
                            x:Name="LblBreadcrumb"
                            Text="Home / Dashboard"
                            FontSize="11"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="2"
                        BackgroundColor="{StaticResource SuccessBg}"
                        Stroke="{StaticResource SuccessBorder}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="10,4"
                        VerticalOptions="Center">

                        <HorizontalStackLayout Spacing="5">

                            <BoxView
                                x:Name="StatusDot"
                                WidthRequest="7"
                                HeightRequest="7"
                                CornerRadius="4"
                                BackgroundColor="{StaticResource StatusOnline}"
                                VerticalOptions="Center" />

                            <Label
                                x:Name="LblConnStatus"
                                Text="Online"
                                FontSize="11"
                                FontAttributes="Bold"
                                TextColor="{StaticResource SuccessText}" />
                        </HorizontalStackLayout>
                    </Border>

                    <VerticalStackLayout
                        Grid.Column="3"
                        Spacing="0"
                        VerticalOptions="Center"
                        HorizontalOptions="End">
                        <Label
                            x:Name="LblHeaderName"
                            FontSize="12"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="End"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label
                            x:Name="LblHeaderEmail"
                            FontSize="10"
                            HorizontalTextAlignment="End"
                            LineBreakMode="TailTruncation"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>

                    <Border
                        x:Name="HeaderProfile"
                        Grid.Column="4"
                        WidthRequest="38"
                        HeightRequest="38"
                        BackgroundColor="{StaticResource Primary100}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 19"
                        AutomationId="HeaderUserIcon"
                        SemanticProperties.Description="Account menu">

                        <Label
                            x:Name="LblHeaderInitials"
                            Text="AU"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryColor}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <ContentView
                x:Name="ContentArea"
                Grid.Column="1"
                Grid.Row="1"
                MinimumWidthRequest="0"
                IsClippedToBounds="True" />
        </Grid>

        <!-- ========================================================= -->
        <!-- MOBILE / TABLET DRAWER                                    -->
        <!-- ========================================================= -->

        <Grid
            x:Name="MobileLayout"
            RowDefinitions="56,*"
            BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}"
            IsVisible="False">

            <Border
                Grid.Row="0"
                Padding="12,0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"
                StrokeThickness="1">

                <Grid
                    ColumnDefinitions="44,*,Auto,44"
                    ColumnSpacing="8">

                    <Button
                        x:Name="BtnMenu"
                        Text="{StaticResource IconMenu}"
                        Style="{StaticResource HeaderIconButton}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource SurfaceColorDark}}"
                        Clicked="OnMobileMenuClicked"
                        VerticalOptions="Center"
                        AutomationId="MobileHeaderSidebarToggle"
                        SemanticProperties.Description="Toggle navigation" />

                    <Label
                        Grid.Column="1"
                        x:Name="MLblPageTitle"
                        Text="Dashboard"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                        VerticalOptions="Center"
                        LineBreakMode="TailTruncation" />

                    <BoxView
                        Grid.Column="2"
                        x:Name="MStatusDot"
                        WidthRequest="8"
                        HeightRequest="8"
                        CornerRadius="4"
                        BackgroundColor="{StaticResource StatusOnline}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />

                    <Border
                        x:Name="MobileProfile"
                        Grid.Column="3"
                        WidthRequest="44"
                        HeightRequest="44"
                        MinimumWidthRequest="44"
                        MinimumHeightRequest="44"
                        BackgroundColor="{StaticResource Primary100}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        VerticalOptions="Center"
                        AutomationId="MobileHeaderUserIcon"
                        SemanticProperties.Description="Account menu">

                        <Label
                            x:Name="MLblHeaderInitials"
                            Text="AU"
                            FontSize="11"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryColor}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>

            <ContentView
                x:Name="MobileContentArea"
                Grid.Row="1"
                IsClippedToBounds="True" />

            <Grid
                x:Name="DrawerOverlay"
                Grid.Row="1"
                IsVisible="False">

                <BoxView
                    x:Name="DrawerScrim"
                    Color="{StaticResource OverlayColor}" />

                <Border
                    x:Name="DrawerPanel"
                    WidthRequest="280"
                    HorizontalOptions="Start"
                    VerticalOptions="Fill"
                    StrokeThickness="0"
                    Padding="0">

                    <layout:AppSidebarView
                        x:Name="MobileSidebar"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill" />
                </Border>
            </Grid>
        </Grid>

        <layout:HeaderAccountMenuOverlay x:Name="AccountMenu" />

    </Grid>
</ContentView>
