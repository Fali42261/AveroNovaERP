<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="AveroNova.App.UI.Views.Products.ProductFormView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:state="clr-namespace:AveroNova.App.UI.Controls.State"
    xmlns:vm="clr-namespace:AveroNova.App.UI.ViewModels"
    x:DataType="vm:ProductFormViewModel">
    <ContentView.Resources>
        <Style x:Key="ProductFormInput" TargetType="Border" BasedOn="{StaticResource InputContainer}">
            <Setter Property="HeightRequest" Value="42" />
            <Setter Property="MinimumHeightRequest" Value="42" />
            <Setter Property="MaximumHeightRequest" Value="44" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalOptions" Value="Start" />
        </Style>
        <Style x:Key="ProductFormFieldEntry" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HeightRequest" Value="42" />
            <Setter Property="MinimumHeightRequest" Value="40" />
            <Setter Property="VerticalOptions" Value="Fill" />
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="ClearButtonVisibility" Value="Never" />
        </Style>
        <Style x:Key="ProductFormActionButton" TargetType="Button">
            <Setter Property="HeightRequest" Value="42" />
            <Setter Property="MinimumHeightRequest" Value="42" />
            <Setter Property="MaximumHeightRequest" Value="44" />
            <Setter Property="MinimumWidthRequest" Value="88" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontAttributes" Value="None" />
            <Setter Property="HorizontalOptions" Value="Start" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="LineBreakMode" Value="NoWrap" />
        </Style>
        <Style x:Key="ProductFormCancelButton" TargetType="Button" BasedOn="{StaticResource ProductFormActionButton}">
            <Setter Property="TextColor" Value="{StaticResource PrimaryColor}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderColor" Value="{StaticResource PrimaryColor}" />
            <Setter Property="BorderWidth" Value="1.5" />
        </Style>
        <Style x:Key="ProductFormSaveButton" TargetType="Button" BasedOn="{StaticResource ProductFormActionButton}">
            <Setter Property="TextColor" Value="{StaticResource White}" />
            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="MinimumWidthRequest" Value="124" />
        </Style>
    </ContentView.Resources>
    <Grid x:Name="Root" RowDefinitions="Auto,*" SizeChanged="OnRootSizeChanged">
        <Border Padding="20,14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*">
                <Button Text="{StaticResource IconBack}" Style="{StaticResource GhostButton}" Padding="0" WidthRequest="40" HeightRequest="40" MinimumHeightRequest="40" Command="{Binding CancelCommand}" />
                <Label Grid.Column="1" Text="{Binding PageTitle}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <state:LoadingView IsVisible="{Binding ShowLoading}" Message="Loading product..." />
            <state:ErrorView x:Name="ErrorState" IsVisible="{Binding ShowError}" Title="Unable to load product" Message="Please try again." />
            <ScrollView IsVisible="{Binding ShowForm}">
                <VerticalStackLayout x:Name="FormBody" Padding="20,16,20,24" Spacing="16">
                    <Border Style="{StaticResource AppCard}">
                        <VerticalStackLayout Spacing="14">
                            <Label Text="Product Details" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                            <BoxView Style="{StaticResource Divider}" />
                            <Grid x:Name="DetailsGrid" ColumnDefinitions="*,*" ColumnSpacing="16" RowSpacing="14" HorizontalOptions="Fill">
                                <VerticalStackLayout Spacing="0"><Label Text="Product Name *" Style="{StaticResource InputLabel}" /><Border Style="{StaticResource ProductFormInput}"><Entry Style="{StaticResource ProductFormFieldEntry}" Placeholder="Enter product name" Text="{Binding Name}" /></Border><Label Text="{Binding NameError}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasNameError}" /></VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="0"><Label Text="SKU / Product Code *" Style="{StaticResource InputLabel}" /><Border Style="{StaticResource ProductFormInput}"><Entry Style="{StaticResource ProductFormFieldEntry}" Placeholder="Enter SKU" Text="{Binding Sku}" /></Border><Label Text="{Binding SkuError}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasSkuError}" /></VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Spacing="0"><Label Text="Barcode" Style="{StaticResource InputLabel}" /><Border Style="{StaticResource ProductFormInput}"><Entry Style="{StaticResource ProductFormFieldEntry}" Placeholder="Enter barcode" Text="{Binding Barcode}" /></Border><Label Text="{Binding BarcodeError}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasBarcodeError}" /></VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="0"><Label Text="Category" Style="{StaticResource InputLabel}" /><Border Style="{StaticResource ProductFormInput}"><Entry Style="{StaticResource ProductFormFieldEntry}" Placeholder="Enter category" Text="{Binding Category}" /></Border></VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Spacing="0"><Label Text="Brand" Style="{StaticResource InputLabel}" /><Border Style="{StaticResource ProductFormInput}"><Entry Style="{StaticResource ProductFormFieldEntry}" Placeholder="Enter brand" Text="{Binding Brand}" /></Border></VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="0"><Label Text="Unit" Style="{StaticResource InputLabel}" /><Border Style="{StaticResource ProductFormInput}"><Picker ItemsSource="{Binding UnitOptions}" SelectedItem="{Binding Unit}" FontSize="14" HeightRequest="42" MinimumHeightRequest="40" HorizontalOptions="Fill" VerticalOptions="Center" BackgroundColor="Transparent" Title="Select unit" /></Border></VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="3" Spacing="0"><Label Text="Purchase Price" Style="{StaticResource InputLabel}" /><Border Style="{StaticResource ProductFormInput}"><Entry Style="{StaticResource ProductFormFieldEntry}" Placeholder="0.00" Keyboard="Numeric" Text="{Binding PurchasePriceText}" /></Border><Label Text="{Binding PurchasePriceError}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasPurchasePriceError}" /></VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="3" Grid.Column="1" Spacing="0"><Label Text="Sale Price *" Style="{StaticResource InputLabel}" /><Border Style="{StaticResource ProductFormInput}"><Entry Style="{StaticResource ProductFormFieldEntry}" Placeholder="0.00" Keyboard="Numeric" Text="{Binding SalePriceText}" /></Border><Label Text="{Binding SalePriceError}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasSalePriceError}" /></VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="4" Spacing="0"><Label Text="Tax / GST" Style="{StaticResource InputLabel}" /><Border Style="{StaticResource ProductFormInput}"><Entry Style="{StaticResource ProductFormFieldEntry}" Placeholder="0" Keyboard="Numeric" Text="{Binding TaxText}" /></Border><Label Text="{Binding TaxError}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasTaxError}" /></VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="4" Grid.Column="1" Spacing="0"><Label Text="Discount" Style="{StaticResource InputLabel}" /><Border Style="{StaticResource ProductFormInput}"><Entry Style="{StaticResource ProductFormFieldEntry}" Placeholder="0" Keyboard="Numeric" Text="{Binding DiscountText}" /></Border><Label Text="{Binding DiscountError}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasDiscountError}" /></VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="5" Spacing="0"><Label Text="Opening Stock" Style="{StaticResource InputLabel}" /><Border Style="{StaticResource ProductFormInput}"><Entry Style="{StaticResource ProductFormFieldEntry}" Placeholder="0" Keyboard="Numeric" Text="{Binding OpeningStockText}" IsReadOnly="{Binding IsOpeningStockReadOnly}" IsEnabled="{Binding IsOpeningStockReadOnly, Converter={StaticResource InverseBoolConverter}}" /></Border><Label Text="{Binding OpeningStockError}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasOpeningStockError}" /></VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="5" Grid.Column="1" Spacing="0"><Label Text="Minimum Stock / Reorder Level" Style="{StaticResource InputLabel}" /><Border Style="{StaticResource ProductFormInput}"><Entry Style="{StaticResource ProductFormFieldEntry}" Placeholder="0" Keyboard="Numeric" Text="{Binding MinimumStockText}" /></Border><Label Text="{Binding MinimumStockError}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasMinimumStockError}" /></VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="6" Spacing="0"><Label Text="Status" Style="{StaticResource InputLabel}" /><Border Style="{StaticResource ProductFormInput}"><Picker ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" FontSize="14" HeightRequest="42" MinimumHeightRequest="40" HorizontalOptions="Fill" VerticalOptions="Center" BackgroundColor="Transparent" Title="Select status" /></Border></VerticalStackLayout>
                                <BoxView Grid.Row="6" Grid.Column="1" Opacity="0" HeightRequest="1" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    <HorizontalStackLayout x:Name="FormActions" Spacing="10" HorizontalOptions="End" Margin="0,4,0,8">
                        <Button Text="Cancel" Style="{StaticResource ProductFormCancelButton}" Command="{Binding CancelCommand}" IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}" />
                        <Grid HeightRequest="42" VerticalOptions="Center"><Button Text="{Binding SaveButtonText}" Style="{StaticResource ProductFormSaveButton}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanPressSave}" /><ActivityIndicator IsVisible="{Binding IsSaving}" IsRunning="{Binding IsSaving}" Color="{StaticResource White}" WidthRequest="18" HeightRequest="18" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,10,0" InputTransparent="True" /></Grid>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentView>
