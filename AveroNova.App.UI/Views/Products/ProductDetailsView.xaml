<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="AveroNova.App.UI.Views.Products.ProductDetailsView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:state="clr-namespace:AveroNova.App.UI.Controls.State"
             xmlns:forms="clr-namespace:AveroNova.App.UI.Controls.Forms"
             xmlns:vm="clr-namespace:AveroNova.App.UI.ViewModels"
             x:DataType="vm:ProductViewViewModel">
    <Grid x:Name="Root" RowDefinitions="Auto,*" SizeChanged="OnRootSizeChanged">
        <Border Padding="20,14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Text="{StaticResource IconBack}" Style="{StaticResource GhostButton}" Padding="0" WidthRequest="40" Command="{Binding BackCommand}" />
                <Label Grid.Column="1" Text="Product Overview" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                <Button Grid.Column="2" Text="Edit Product" Style="{StaticResource SmallButton}" HeightRequest="40" Padding="16,0" Command="{Binding EditCommand}" IsVisible="{Binding ShowEditButton}" />
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <state:LoadingView IsVisible="{Binding ShowLoading}" Message="Loading product..." />
            <state:ErrorView x:Name="ErrorState" IsVisible="{Binding ShowError}" Title="Unable to load product" Message="Please try again." />
            <state:EmptyView x:Name="NotFoundState" IsVisible="{Binding ShowNotFound}" Title="Product not found." Subtitle="This product is not available for the current company." ActionLabel="Back to Products" />
            <ScrollView IsVisible="{Binding ShowContent}">
                <VerticalStackLayout Padding="20,16,20,24" Spacing="18">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Product Details" Style="{StaticResource SectionTitle}" />
                        <Grid x:Name="ProductFieldsGrid" ColumnDefinitions="*,*,*" ColumnSpacing="16" RowSpacing="16">
                            <forms:ReadOnlyFieldCard LabelText="Product Name" ValueText="{Binding DisplayName}" />
                            <forms:ReadOnlyFieldCard Grid.Column="1" LabelText="SKU / Product Code" ValueText="{Binding DisplaySku}" />
                            <forms:ReadOnlyFieldCard Grid.Column="2" LabelText="Barcode" ValueText="{Binding DisplayBarcode}" />
                            <forms:ReadOnlyFieldCard Grid.Row="1" LabelText="Category" ValueText="{Binding DisplayCategory}" />
                            <forms:ReadOnlyFieldCard Grid.Row="1" Grid.Column="1" LabelText="Brand" ValueText="{Binding DisplayBrand}" />
                            <forms:ReadOnlyFieldCard Grid.Row="1" Grid.Column="2" LabelText="Unit" ValueText="{Binding DisplayUnit}" />
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Pricing" Style="{StaticResource SectionTitle}" />
                        <Grid x:Name="PricingFieldsGrid" ColumnDefinitions="*,*,*,*" ColumnSpacing="16" RowSpacing="16">
                            <forms:ReadOnlyFieldCard LabelText="Purchase Price" ValueText="{Binding DisplayPurchasePrice}" />
                            <forms:ReadOnlyFieldCard Grid.Column="1" LabelText="Sale Price" ValueText="{Binding DisplaySalePrice}" />
                            <forms:ReadOnlyFieldCard Grid.Column="2" LabelText="GST" ValueText="{Binding DisplayTax}" />
                            <forms:ReadOnlyFieldCard Grid.Column="3" LabelText="Discount" ValueText="{Binding DisplayDiscount}" />
                        </Grid>
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Inventory" Style="{StaticResource SectionTitle}" />
                        <Grid x:Name="InventoryFieldsGrid" ColumnDefinitions="*,*,*" ColumnSpacing="16" RowSpacing="16">
                            <forms:ReadOnlyFieldCard LabelText="Current Stock" ValueText="{Binding DisplayStock}" />
                            <forms:ReadOnlyFieldCard Grid.Column="1" LabelText="Opening Stock" ValueText="{Binding DisplayOpeningStock}" />
                            <forms:ReadOnlyFieldCard Grid.Column="2" LabelText="Minimum Stock" ValueText="{Binding DisplayMinimumStock}" />
                            <forms:ReadOnlyFieldCard Grid.Row="1" LabelText="Reorder Level" ValueText="{Binding DisplayReorderLevel}" />
                            <forms:ReadOnlyFieldCard Grid.Row="1" Grid.Column="1" LabelText="Status" ValueText="{Binding DisplayStatus}" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentView>
