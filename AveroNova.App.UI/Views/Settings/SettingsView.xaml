<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AveroNova.App.UI.Views.Settings.SettingsView">

    <ScrollView>
        <VerticalStackLayout Padding="28" Spacing="20">

            <Label
                Text="Settings"
                FontSize="26" FontAttributes="Bold"
                TextColor="{StaticResource TextPrimary}" />

            <Label
                Text="Manage your application preferences and system configuration."
                FontSize="14"
                TextColor="{StaticResource TextSecondary}" />

            <!-- Placeholder card -->
            <Border
                Padding="22"
                BackgroundColor="{StaticResource CardBackground}"
                Stroke="{StaticResource BorderColor}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 14">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Application Settings"
                        FontSize="16" FontAttributes="Bold"
                        TextColor="{StaticResource TextPrimary}" />

                    <BoxView HeightRequest="1" BackgroundColor="{StaticResource BorderColor}" />

                    <Label
                        Text="Settings configuration will be available in a future update."
                        FontSize="14"
                        TextColor="{StaticResource TextSecondary}" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentView>
