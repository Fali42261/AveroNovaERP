<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="AveroNova.App.UI.Views.Company.CompanySidebarItemView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Name="This">

    <Border
        x:Name="ItemBorder"
        Margin="0,4"
        Padding="14"
        BackgroundColor="Transparent"
        Stroke="Transparent"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 14">

        <Grid
            ColumnSpacing="14"
            VerticalOptions="Center">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="44"/>

                <ColumnDefinition Width="*"/>

            </Grid.ColumnDefinitions>

            <!-- Step Circle -->

            <Border
                x:Name="StepCircle"
                WidthRequest="40"
                HeightRequest="40"
                BackgroundColor="#233B73"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <Label
                    x:Name="StepNumberLabel"
                    Text="{Binding StepNumber, Source={x:Reference This}}"
                    FontSize="16"
                    FontAttributes="Bold"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    TextColor="White"/>

            </Border>

            <!-- Text -->

            <VerticalStackLayout
                Grid.Column="1"
                Spacing="2"
                VerticalOptions="Center">
                <Label
    x:Name="TitleLabel"
    Text="{Binding Title, Source={x:Reference This}}"
    FontSize="15"
    FontAttributes="Bold"
    LineBreakMode="TailTruncation"
    MaxLines="1"
    TextColor="White"
    ToolTipProperties.Text="{Binding Title, Source={x:Reference This}}"/>

                <Label
    x:Name="SubtitleLabel"
    Text="{Binding Subtitle, Source={x:Reference This}}"
    FontSize="11"
    TextColor="#94A3B8"
    LineBreakMode="TailTruncation"
    MaxLines="1"
    ToolTipProperties.Text="{Binding Subtitle, Source={x:Reference This}}"/>

            </VerticalStackLayout>

        </Grid>

    </Border>

</ContentView>