<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="AveroNova.App.UI.Views.Company.CompanyDetailsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>

        <VerticalStackLayout
            Padding="28"
            Spacing="20">

            <!-- Header -->

            <VerticalStackLayout Spacing="5">
                <Label
                    Text="View and manage your company information."
                    FontSize="15"
                    TextColor="#64748B" />

            </VerticalStackLayout>


            <!-- Company Information -->

            <Border
                Padding="25"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="20">

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                            Text="Company Information"
                            FontSize="21"
                            FontAttributes="Bold"
                            TextColor="#0F172A" />

                        <Button
                            Grid.Column="1"
                            Text="✎  Edit"
                            HeightRequest="42"
                            Padding="18,0"
                            BackgroundColor="Transparent"
                            BorderColor="#2563EB"
                            BorderWidth="1"
                            TextColor="#2563EB"
                            CornerRadius="8" />

                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="#E2E8F0" />

                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="35"
                        RowSpacing="20">

                        <!-- Company Name -->

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Company Name"
                                FontSize="14"
                                TextColor="#64748B" />

                            <Label
                                Text="AveroNova ERP"
                                FontSize="16"
                                TextColor="#0F172A" />

                        </VerticalStackLayout>


                        <!-- Owner -->

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="5">

                            <Label
                                Text="Owner Name"
                                FontSize="14"
                                TextColor="#64748B" />

                            <Label
                                Text="Faizan Ali"
                                FontSize="16"
                                TextColor="#0F172A" />

                        </VerticalStackLayout>


                        <!-- GST -->

                        <VerticalStackLayout
                            Grid.Row="1"
                            Spacing="5">

                            <Label
                                Text="GST Number"
                                FontSize="14"
                                TextColor="#64748B" />

                            <Label
                                Text="Not Available"
                                FontSize="16"
                                TextColor="#0F172A" />

                        </VerticalStackLayout>


                        <!-- PAN -->

                        <VerticalStackLayout
                            Grid.Row="1"
                            Grid.Column="1"
                            Spacing="5">

                            <Label
                                Text="PAN Number"
                                FontSize="14"
                                TextColor="#64748B" />

                            <Label
                                Text="Not Available"
                                FontSize="16"
                                TextColor="#0F172A" />

                        </VerticalStackLayout>


                        <!-- Email -->

                        <VerticalStackLayout
                            Grid.Row="2"
                            Spacing="5">

                            <Label
                                Text="Email"
                                FontSize="14"
                                TextColor="#64748B" />

                            <Label
                                Text="Not Available"
                                FontSize="16"
                                TextColor="#0F172A" />

                        </VerticalStackLayout>


                        <!-- Mobile -->

                        <VerticalStackLayout
                            Grid.Row="2"
                            Grid.Column="1"
                            Spacing="5">

                            <Label
                                Text="Mobile Number"
                                FontSize="14"
                                TextColor="#64748B" />

                            <Label
                                Text="Not Available"
                                FontSize="16"
                                TextColor="#0F172A" />

                        </VerticalStackLayout>

                    </Grid>

                </VerticalStackLayout>

            </Border>


            <!-- Address -->

            <Border
                Padding="25"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="20">

                    <Label
                        Text="Address"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#0F172A" />

                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="#E2E8F0" />

                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="35"
                        RowSpacing="20">

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Address"
                                FontSize="14"
                                TextColor="#64748B" />

                            <Label
                                Text="Not Available"
                                FontSize="16"
                                TextColor="#0F172A" />

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Spacing="5">

                            <Label
                                Text="State"
                                FontSize="14"
                                TextColor="#64748B" />

                            <Label
                                Text="Not Available"
                                FontSize="16"
                                TextColor="#0F172A" />

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Row="1"
                            Spacing="5">

                            <Label
                                Text="City"
                                FontSize="14"
                                TextColor="#64748B" />

                            <Label
                                Text="Not Available"
                                FontSize="16"
                                TextColor="#0F172A" />

                        </VerticalStackLayout>

                        <VerticalStackLayout
                            Grid.Row="1"
                            Grid.Column="1"
                            Spacing="5">

                            <Label
                                Text="Pincode"
                                FontSize="14"
                                TextColor="#64748B" />

                            <Label
                                Text="Not Available"
                                FontSize="16"
                                TextColor="#0F172A" />

                        </VerticalStackLayout>

                    </Grid>

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>

    </ScrollView>

</ContentView>