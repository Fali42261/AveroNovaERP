<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="AveroNova.App.UI.Views.Company.FinishSetupView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="20">

            <!-- Company Information -->

            <Border
                Padding="18"
                Stroke="{StaticResource BorderColor}"
                StrokeShape="RoundRectangle 12">

                <VerticalStackLayout Spacing="10">

                    <HorizontalStackLayout>
                        <Label WidthRequest="180"
               FontAttributes="Bold"
               Text="Company Name :" />
                        <Label Text="{Binding CompanyName}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label WidthRequest="180"
               FontAttributes="Bold"
               Text="Owner Name :" />
                        <Label Text="{Binding OwnerName}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label WidthRequest="180"
               FontAttributes="Bold"
               Text="GST Number :" />
                        <Label Text="{Binding GSTNumber}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label WidthRequest="180"
               FontAttributes="Bold"
               Text="PAN Number :" />
                        <Label Text="{Binding PANNumber}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label WidthRequest="180"
               FontAttributes="Bold"
               Text="Email :" />
                        <Label Text="{Binding Email}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label WidthRequest="180"
               FontAttributes="Bold"
               Text="Mobile :" />
                        <Label Text="{Binding MobileNumber}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label WidthRequest="180"
               FontAttributes="Bold"
               Text="Address :" />
                        <Label Text="{Binding Address}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label WidthRequest="180"
               FontAttributes="Bold"
               Text="City :" />
                        <Label Text="{Binding City}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label WidthRequest="180"
               FontAttributes="Bold"
               Text="State :" />
                        <Label Text="{Binding State}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label WidthRequest="180"
               FontAttributes="Bold"
               Text="Country :" />
                        <Label Text="{Binding Country}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout>
                        <Label WidthRequest="180"
               FontAttributes="Bold"
               Text="Pin Code :" />
                        <Label Text="{Binding PinCode}" />
                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Border>

            <!-- Ready -->

            <Border
    Padding="16"
    BackgroundColor="#ECFDF5"
    Stroke="#10B981"
    StrokeThickness="1"
    StrokeShape="RoundRectangle 12">

                <Grid
        ColumnDefinitions="Auto,*"
        ColumnSpacing="16"
        VerticalOptions="Center">

                    <!-- Success Icon -->
                    <Border
            WidthRequest="40"
            HeightRequest="40"
            BackgroundColor="#10B981"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 8"
            HorizontalOptions="Center"
            VerticalOptions="Center">

                        <Label
                Text="✔"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"/>

                    </Border>

                    <!-- Message -->

                    <VerticalStackLayout
            Grid.Column="1"
            Spacing="4"
            VerticalOptions="Center">

                        <Label
                Text="Ready to Create"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="#111827"/>

                        <Label
                Text="Click Finish to create your company."
                FontSize="14"
                TextColor="#374151"/>

                    </VerticalStackLayout>

                </Grid>

            </Border>
        </VerticalStackLayout>

    </ScrollView>

</ContentView>