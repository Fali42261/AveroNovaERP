<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:resources="clr-namespace:AveroNova.App.UI.Resources"
    x:Class="AveroNova.App.UI.Resources.Theme">

    <ResourceDictionary.MergedDictionaries>
        <resources:Colors />
    </ResourceDictionary.MergedDictionaries>
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  AVERONOVA ERP — THEME BRUSHES                                      -->
    <!--  SolidColorBrush wrappers for color tokens.                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <SolidColorBrush x:Key="PrimaryBrush"         Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush"      Color="{StaticResource PrimaryDark}" />
    <SolidColorBrush x:Key="CardBrush"             Color="{StaticResource CardBackground}" />
    <SolidColorBrush x:Key="SidebarBrush"          Color="{StaticResource SidebarBackground}" />
    <SolidColorBrush x:Key="BackgroundBrush"       Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrush"           Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SuccessBrush"          Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="ErrorBrush"            Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="WarningBrush"          Color="{StaticResource WarningColor}" />

</ResourceDictionary>
