<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AveroNova.App.UI.Resources.Colors">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  AVERONOVA ERP — DESIGN SYSTEM — COLOR TOKENS                      -->
    <!--  Single source of truth for every color used in the application.   -->
    <!--  Do NOT hard-code hex values anywhere else in the UI layer.         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- ── Primitives ─────────────────────────────────────────────────── -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Transparent">Transparent</Color>

    <!-- ── Gray Scale ─────────────────────────────────────────────────── -->
    <Color x:Key="Gray50">#F9FAFB</Color>
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray700">#374151</Color>
    <Color x:Key="Gray800">#1F2937</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#030712</Color>

    <!-- ── Primary — Blue ─────────────────────────────────────────────── -->
    <Color x:Key="Primary50">#EFF6FF</Color>
    <Color x:Key="Primary100">#DBEAFE</Color>
    <Color x:Key="Primary200">#BFDBFE</Color>
    <Color x:Key="Primary300">#93C5FD</Color>
    <Color x:Key="Primary400">#60A5FA</Color>
    <Color x:Key="Primary500">#3B82F6</Color>
    <Color x:Key="Primary600">#2563EB</Color>
    <Color x:Key="Primary700">#1D4ED8</Color>
    <Color x:Key="Primary800">#1E40AF</Color>
    <Color x:Key="Primary900">#1E3A8A</Color>

    <!-- ── Success — Green ────────────────────────────────────────────── -->
    <Color x:Key="Success50">#ECFDF5</Color>
    <Color x:Key="Success100">#D1FAE5</Color>
    <Color x:Key="Success200">#A7F3D0</Color>
    <Color x:Key="Success500">#10B981</Color>
    <Color x:Key="Success600">#059669</Color>
    <Color x:Key="Success700">#047857</Color>

    <!-- ── Warning — Amber ────────────────────────────────────────────── -->
    <Color x:Key="Warning50">#FFFBEB</Color>
    <Color x:Key="Warning100">#FEF3C7</Color>
    <Color x:Key="Warning200">#FDE68A</Color>
    <Color x:Key="Warning500">#F59E0B</Color>
    <Color x:Key="Warning600">#D97706</Color>
    <Color x:Key="Warning700">#B45309</Color>

    <!-- ── Error — Red ────────────────────────────────────────────────── -->
    <Color x:Key="Error50">#FEF2F2</Color>
    <Color x:Key="Error100">#FEE2E2</Color>
    <Color x:Key="Error200">#FECACA</Color>
    <Color x:Key="Error500">#EF4444</Color>
    <Color x:Key="Error600">#DC2626</Color>
    <Color x:Key="Error700">#B91C1C</Color>

    <!-- ── Info — Cyan ────────────────────────────────────────────────── -->
    <Color x:Key="Info50">#ECFEFF</Color>
    <Color x:Key="Info100">#CFFAFE</Color>
    <Color x:Key="Info500">#06B6D4</Color>
    <Color x:Key="Info600">#0891B2</Color>

    <!-- ── Purple ─────────────────────────────────────────────────────── -->
    <Color x:Key="Purple50">#F5F3FF</Color>
    <Color x:Key="Purple100">#EDE9FE</Color>
    <Color x:Key="Purple200">#DDD6FE</Color>
    <Color x:Key="Purple500">#8B5CF6</Color>
    <Color x:Key="Purple600">#7C3AED</Color>

    <!-- ── Orange ─────────────────────────────────────────────────────── -->
    <Color x:Key="Orange50">#FFF7ED</Color>
    <Color x:Key="Orange100">#FFEDD5</Color>
    <Color x:Key="Orange500">#F97316</Color>
    <Color x:Key="Orange600">#EA580C</Color>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  SEMANTIC ALIASES  — Use these throughout the UI, not primitives.  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- Brand -->
    <Color x:Key="PrimaryColor">#2563EB</Color>
    <Color x:Key="PrimaryDark">#1E40AF</Color>
    <Color x:Key="PrimaryLight">#DBEAFE</Color>
    <Color x:Key="PrimaryDarkText">#BFDBFE</Color>
    <Color x:Key="Secondary">#10B981</Color>
    <Color x:Key="SecondaryDarkText">#D1FAE5</Color>

    <!-- Backgrounds -->
    <Color x:Key="BackgroundColor">#F8FAFC</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="CardBackground">#FFFFFF</Color>

    <!-- Dark mode backgrounds -->
    <Color x:Key="BackgroundColorDark">#0F172A</Color>
    <Color x:Key="SurfaceColorDark">#1E293B</Color>
    <Color x:Key="CardBackgroundDark">#1E293B</Color>

    <!-- Sidebar — theme-aware (do not hard-code a separate sidebar theme) -->
    <Color x:Key="SidebarBackground">#0F172A</Color>
    <Color x:Key="SidebarBackgroundLight">#FFFFFF</Color>
    <Color x:Key="SidebarBackgroundDark">#0F172A</Color>
    <Color x:Key="SidebarActiveItem">#1D4ED8</Color>
    <Color x:Key="SidebarActiveItemLight">#DBEAFE</Color>
    <Color x:Key="SidebarActiveItemDark">#1E3A8A</Color>
    <Color x:Key="SidebarItemHover">#1E293B</Color>
    <Color x:Key="SidebarItemHoverLight">#F1F5F9</Color>
    <Color x:Key="SidebarItemHoverDark">#1E293B</Color>
    <Color x:Key="SidebarText">#CBD5E1</Color>
    <Color x:Key="SidebarTextLight">#334155</Color>
    <Color x:Key="SidebarTextDark">#CBD5E1</Color>
    <Color x:Key="SidebarActiveTextLight">#1D4ED8</Color>
    <Color x:Key="SidebarActiveTextDark">#FFFFFF</Color>
    <Color x:Key="SidebarGroupLabel">#475569</Color>
    <Color x:Key="SidebarMutedLight">#64748B</Color>
    <Color x:Key="SidebarMutedDark">#94A3B8</Color>
    <Color x:Key="SidebarBorderLight">#E2E8F0</Color>
    <Color x:Key="SidebarBorderDark">#1E293B</Color>
    <Color x:Key="SidebarIndicator">#2563EB</Color>

    <!-- Borders -->
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="BorderColorDark">#334155</Color>
    <Color x:Key="DividerColor">#F1F5F9</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#0F172A</Color>
    <Color x:Key="TextSecondary">#64748B</Color>
    <Color x:Key="TextTertiary">#94A3B8</Color>
    <Color x:Key="TextPrimaryDark">#F1F5F9</Color>
    <Color x:Key="TextSecondaryDark">#94A3B8</Color>
    <Color x:Key="TextDisabled">#CBD5E1</Color>

    <!-- Input -->
    <Color x:Key="InputBackground">#FFFFFF</Color>
    <Color x:Key="InputBackgroundDark">#1E293B</Color>
    <Color x:Key="InputBorder">#D1D5DB</Color>
    <Color x:Key="InputFocusBorder">#2563EB</Color>
    <Color x:Key="InputPlaceholder">#9CA3AF</Color>
    <Color x:Key="InputPlaceholderDark">#CBD5E1</Color>
    <Color x:Key="InputText">#0F172A</Color>
    <Color x:Key="InputTextDark">#FFFFFF</Color>

    <!-- Status — Semantic -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="SuccessBg">#ECFDF5</Color>
    <Color x:Key="SuccessBorder">#A7F3D0</Color>
    <Color x:Key="SuccessText">#059669</Color>

    <Color x:Key="ErrorColor">#EF4444</Color>
    <Color x:Key="ErrorBg">#FEF2F2</Color>
    <Color x:Key="ErrorBorder">#FECACA</Color>
    <Color x:Key="ErrorText">#DC2626</Color>

    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="WarningBg">#FFFBEB</Color>
    <Color x:Key="WarningBorder">#FDE68A</Color>
    <Color x:Key="WarningText">#D97706</Color>

    <Color x:Key="InfoColor">#3B82F6</Color>
    <Color x:Key="InfoBg">#EFF6FF</Color>
    <Color x:Key="InfoBorder">#BFDBFE</Color>
    <Color x:Key="InfoText">#2563EB</Color>

    <!-- Subscription plan cards -->
    <Color x:Key="PlanSelectedFill">#EFF6FF</Color>
    <Color x:Key="PlanSelectedFillDark">#172554</Color>
    <Color x:Key="PlanInfoFill">#F8FAFC</Color>
    <Color x:Key="PlanInfoFillDark">#0F172A</Color>

    <!-- Connectivity Status -->
    <Color x:Key="StatusOnline">#10B981</Color>
    <Color x:Key="StatusOffline">#EF4444</Color>
    <Color x:Key="StatusSyncing">#3B82F6</Color>
    <Color x:Key="StatusSynced">#10B981</Color>
    <Color x:Key="StatusSyncFailed">#EF4444</Color>
    <Color x:Key="StatusPending">#F59E0B</Color>

    <!-- Overlay -->
    <Color x:Key="OverlayColor">#80000000</Color>
    <Color x:Key="SkeletonBase">#E2E8F0</Color>
    <Color x:Key="SkeletonHighlight">#F1F5F9</Color>

    <!-- Legacy aliases kept for backward compat -->
    <Color x:Key="OffBlack">#1E1E1E</Color>
    <Color x:Key="MidnightBlue">#1E3A8A</Color>
    <Color x:Key="Magenta">#D946EF</Color>

</ResourceDictionary>
