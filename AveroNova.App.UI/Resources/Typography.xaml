<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:resources="clr-namespace:AveroNova.App.UI.Resources"
    x:Class="AveroNova.App.UI.Resources.Typography">

    <ResourceDictionary.MergedDictionaries>
        <resources:Colors />
        <resources:Dimensions />
        <!--<resources:Styles/>-->
    </ResourceDictionary.MergedDictionaries>
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  AVERONOVA ERP — TYPOGRAPHY TOKENS                                  -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- ── Font Sizes ────────────────────────────────────────────────── -->
    <x:Double x:Key="FontSizeXXSmall">10</x:Double>
    <x:Double x:Key="FontSizeXSmall">11</x:Double>
    <x:Double x:Key="FontSizeSmall">12</x:Double>
    <x:Double x:Key="FontSizeBody">14</x:Double>
    <x:Double x:Key="FontSizeMedium">15</x:Double>
    <x:Double x:Key="FontSizeSubHeading">16</x:Double>
    <x:Double x:Key="FontSizeHeading">18</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="SidebarBrandFontSize">20</x:Double>
    <x:Double x:Key="SidebarBrandSubtitleFontSize">13</x:Double>
    <x:Double x:Key="SidebarSectionFontSize">11</x:Double>
    <x:Double x:Key="SidebarMenuFontSize">14</x:Double>
    <x:Double x:Key="SidebarChildFontSize">13</x:Double>
    <x:Double x:Key="FontSizeLargeTitle">24</x:Double>
    <x:Double x:Key="FontSizeXLargeTitle">28</x:Double>
    <x:Double x:Key="FontSizeDisplay">32</x:Double>
    <x:Double x:Key="FontSizeHero">40</x:Double>

    <!-- ── Icon Sizes ─────────────────────────────────────────────────── -->
    <x:Double x:Key="IconSizeXSmall">12</x:Double>
    <x:Double x:Key="IconSizeSmall">16</x:Double>
    <x:Double x:Key="IconSizeMedium">20</x:Double>
    <x:Double x:Key="IconSizeLarge">24</x:Double>
    <x:Double x:Key="IconSizeXLarge">32</x:Double>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!--  SEMANTIC LABEL STYLES                                              -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="DisplayText" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeLargeTitle}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubHeading}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="CardTitle" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="BodyText" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style x:Key="BodyTextSmall" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="SecondaryText" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style x:Key="CaptionText" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXSmall}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource TextSecondaryDark}}" />
    </Style>

    <Style x:Key="LabelText" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="InputLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="ReviewFieldLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="ReviewFieldValue" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="ErrorText" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXSmall}" />
        <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style x:Key="LinkText" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="MetricValue" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="MetricLabel" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXSmall}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="CharacterSpacing" Value="0.5" />
    </Style>

    <Style x:Key="TableHeader" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeXSmall}" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
        <Setter Property="CharacterSpacing" Value="0.5" />
    </Style>

    <Style x:Key="SidebarBrand" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource SidebarBrandFontSize}" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="LineHeight" Value="1.2" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <Style x:Key="SidebarBrandSubtitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource SidebarBrandSubtitleFontSize}" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="LineHeight" Value="1.2" />
        <Setter Property="CharacterSpacing" Value="0.2" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SidebarMutedLight}, Dark={StaticResource SidebarMutedDark}}" />
    </Style>

    <Style x:Key="SidebarSection" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource SidebarSectionFontSize}" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="CharacterSpacing" Value="0.8" />
        <Setter Property="LineHeight" Value="1.2" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SidebarMutedLight}, Dark={StaticResource SidebarMutedDark}}" />
    </Style>

    <Style x:Key="SidebarMenuItem" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource SidebarMenuFontSize}" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="LineHeight" Value="1.25" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SidebarTextLight}, Dark={StaticResource SidebarTextDark}}" />
    </Style>

    <Style x:Key="SidebarChildItem" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource SidebarChildFontSize}" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="LineHeight" Value="1.25" />
        <Setter Property="CharacterSpacing" Value="0" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SidebarTextLight}, Dark={StaticResource SidebarTextDark}}" />
    </Style>

    <Style x:Key="SidebarIcon" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource SidebarIconSize}" />
        <Setter Property="WidthRequest" Value="{StaticResource SidebarIconSlot}" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="NoWrap" />
        <Setter Property="FontFamily">
            <OnPlatform x:TypeArguments="x:String">
                <On Platform="WinUI" Value="Segoe UI Symbol" />
                <On Platform="Windows" Value="Segoe UI Symbol" />
                <On Platform="Android" Value="sans-serif" />
                <On Platform="iOS" Value="Helvetica Neue" />
                <On Platform="MacCatalyst" Value="Helvetica Neue" />
            </OnPlatform>
        </Setter>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SidebarTextLight}, Dark={StaticResource SidebarTextDark}}" />
    </Style>

    <Style x:Key="MonospaceText" TargetType="Label">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
    </Style>

    <!-- ── Headline styles (legacy compat) ───────────────────────────── -->
    <Style x:Key="Headline" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <Style x:Key="SubHeadline" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
