<?xml version="1.0" encoding="utf-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:resources="clr-namespace:AveroNova.App.UI.Resources"
    x:Class="AveroNova.App.UI.Resources.Styles">

    <ResourceDictionary.MergedDictionaries>
        <resources:Colors />
        <resources:Dimensions />
    </ResourceDictionary.MergedDictionaries>

    <!-- ══════════════════════════════════════════════════════════════════ -->
    <!--  AVERONOVA ERP — COMPONENT STYLES                                  -->
    <!-- ══════════════════════════════════════════════════════════════════ -->

    <!-- ── Base Types ──────────────────────────────────────────────────── -->
    <!--<Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}" />
    </Style>-->

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InputText}, Dark={StaticResource InputTextDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource InputPlaceholder}, Dark={StaticResource InputPlaceholderDark}}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InputText}, Dark={StaticResource InputTextDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource InputPlaceholder}, Dark={StaticResource InputPlaceholderDark}}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InputText}, Dark={StaticResource InputTextDark}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource InputPlaceholder}, Dark={StaticResource InputPlaceholderDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InputText}, Dark={StaticResource InputTextDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource InputPlaceholder}, Dark={StaticResource InputPlaceholderDark}}" />
        <Setter Property="CancelButtonColor" Value="{AppThemeBinding Light={StaticResource InputText}, Dark={StaticResource InputTextDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InputText}, Dark={StaticResource InputTextDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InputText}, Dark={StaticResource InputTextDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{StaticResource PrimaryColor}" />
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="ThumbColor" Value="{StaticResource White}" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <!-- <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource Gray300}"/>
                            <Setter Property="TextColor" Value="{StaticResource Gray500}"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver"/>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter> -->
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource PrimaryColor}"/>
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource PrimaryColor}"/>
    </Style>
    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{StaticResource PrimaryColor}"/>
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BackgroundColorDark}}"/>
        <Setter Property="Shell.ForegroundColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
        <Setter Property="Shell.NavBarHasShadow" Value="False"/>
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource BackgroundColorDark}}"/>
        <Setter Property="BarTextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════════ -->
    <!--  NAMED COMPONENT STYLES                                            -->
    <!-- ══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="HeightRequest" Value="{StaticResource ButtonHeight}"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ButtonHeight}"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="BorderColor" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="BorderWidth" Value="1.5"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
    </Style>

    <Style x:Key="LightSecondaryButton" TargetType="Button">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}"/>
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="HeightRequest" Value="{StaticResource ButtonHeight}"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ButtonHeight}"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
    </Style>

    <Style x:Key="WizardSecondaryButton" TargetType="Button" BasedOn="{StaticResource LightSecondaryButton}">
        <Setter Property="HorizontalOptions" Value="Start"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="HeightRequest" Value="{StaticResource ButtonHeight}"/>
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ButtonHeight}"/>
        <Setter Property="MinimumWidthRequest" Value="{StaticResource WizardButtonMinWidth}"/>
        <Setter Property="LineBreakMode" Value="NoWrap"/>
    </Style>

    <Style x:Key="WizardPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="HorizontalOptions" Value="Start"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="HeightRequest" Value="{StaticResource ButtonHeight}"/>
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ButtonHeight}"/>
        <Setter Property="MinimumWidthRequest" Value="{StaticResource WizardPrimaryButtonMinWidth}"/>
        <Setter Property="LineBreakMode" Value="NoWrap"/>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource ErrorColor}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="Padding" Value="20,0"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="HeightRequest" Value="48"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
    </Style>

    <Style x:Key="SmallButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource White}"/>
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HeightRequest" Value="36"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinimumHeightRequest" Value="36"/>
    </Style>

    <Style x:Key="SmallSecondaryButton" TargetType="Button">
        <Setter Property="TextColor" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="BorderColor" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="BorderWidth" Value="1"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HeightRequest" Value="36"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="MinimumHeightRequest" Value="36"/>
    </Style>

    <!-- Card -->
    <Style x:Key="AppCard" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 16"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="AuthCard" TargetType="Border" BasedOn="{StaticResource AppCard}">
        <Setter Property="Padding" Value="24"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
    </Style>

    <Style x:Key="ReviewCard" TargetType="Border" BasedOn="{StaticResource AppCard}">
        <Setter Property="Padding" Value="20"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="VerticalOptions" Value="Fill"/>
        <Setter Property="MinimumWidthRequest" Value="0"/>
    </Style>

    <Style x:Key="PlanCard" TargetType="Border" BasedOn="{StaticResource AppCard}">
        <Setter Property="Padding" Value="20"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="VerticalOptions" Value="Fill"/>
    </Style>

    <Style x:Key="PlanCardSelected" TargetType="Border" BasedOn="{StaticResource PlanCard}">
        <Setter Property="Stroke" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="StrokeThickness" Value="2"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PlanSelectedFill}, Dark={StaticResource PlanSelectedFillDark}}"/>
    </Style>

    <Style x:Key="PlanCardTitle" TargetType="Label">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="LineBreakMode" Value="WordWrap"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
    </Style>

    <Style x:Key="PlanCardPrice" TargetType="Label">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="LineBreakMode" Value="WordWrap"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
    </Style>

    <Style x:Key="PlanCardSupporting" TargetType="Label">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineBreakMode" Value="WordWrap"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
    </Style>

    <Style x:Key="PlanCardDescription" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineBreakMode" Value="WordWrap"/>
        <Setter Property="MaxLines" Value="4"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
    </Style>

    <Style x:Key="PlanCardSectionHeading" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="LineBreakMode" Value="NoWrap"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
    </Style>

    <Style x:Key="PlanCardCheckIcon" TargetType="Label">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="LineBreakMode" Value="NoWrap"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="VerticalOptions" Value="Start"/>
        <Setter Property="TextColor" Value="{StaticResource PrimaryColor}"/>
        <Setter Property="FontFamily">
            <OnPlatform x:TypeArguments="x:String">
                <On Platform="WinUI" Value="Segoe UI Symbol"/>
                <On Platform="Windows" Value="Segoe UI Symbol"/>
                <On Platform="Android" Value="sans-serif-medium"/>
                <On Platform="iOS" Value="Helvetica Neue"/>
                <On Platform="MacCatalyst" Value="Helvetica Neue"/>
            </OnPlatform>
        </Setter>
    </Style>

    <Style x:Key="PlanCardFeatureText" TargetType="Label">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineBreakMode" Value="WordWrap"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
    </Style>

    <!-- Global AveroNova input container (no native/platform border) -->
    <Style x:Key="InputContainer" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource InputBackgroundDark}}"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="MinimumHeightRequest" Value="48"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
    </Style>

    <Style x:Key="AuthField" TargetType="Border" BasedOn="{StaticResource InputContainer}" />

    <!-- Authentication screens only — soft SaaS input, no platform chrome -->
    <Style x:Key="AuthenticationInput" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource InputBackgroundDark}}"/>
        <Setter Property="Stroke" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="HeightRequest" Value="52"/>
        <Setter Property="MinimumHeightRequest" Value="48"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
    </Style>

    <Style x:Key="AuthFieldIcon" TargetType="Label">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextColor" Value="{StaticResource TextTertiary}"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="WidthRequest" Value="28"/>
    </Style>

    <Style x:Key="AuthEyeButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="WidthRequest" Value="44"/>
        <Setter Property="HeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="VerticalOptions" Value="Center"/>
    </Style>

    <!-- List row -->
    <Style x:Key="ListRow" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"/>
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>

    <!-- Divider -->
    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1"/>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource DividerColor}, Dark={StaticResource BorderColorDark}}"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
    </Style>

    <!-- Badge base -->
    <Style x:Key="BadgeBase" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 999"/>
        <Setter Property="Padding" Value="8,3"/>
    </Style>
    <Style x:Key="BadgeSuccess" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource SuccessBg}"/>
    </Style>
    <Style x:Key="BadgeError" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource ErrorBg}"/>
    </Style>
    <Style x:Key="BadgeWarning" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource WarningBg}"/>
    </Style>
    <Style x:Key="BadgeInfo" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource InfoBg}"/>
    </Style>
    <Style x:Key="BadgePurple" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource Purple50}"/>
    </Style>
    <Style x:Key="BadgeGray" TargetType="Border" BasedOn="{StaticResource BadgeBase}">
        <Setter Property="BackgroundColor" Value="{StaticResource Gray100}"/>
    </Style>

    <!-- Sidebar nav items (legacy Button styles kept for compatibility) -->
    <Style x:Key="SidebarNavItem" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SidebarTextLight}, Dark={StaticResource SidebarTextDark}}"/>
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="HeightRequest" Value="{StaticResource SidebarItemHeight}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="MinimumHeightRequest" Value="{StaticResource SidebarItemHeight}"/>
    </Style>

    <Style x:Key="SidebarNavItemActive" TargetType="Button" BasedOn="{StaticResource SidebarNavItem}">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SidebarActiveItemLight}, Dark={StaticResource SidebarActiveItemDark}}"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SidebarActiveTextLight}, Dark={StaticResource SidebarActiveTextDark}}"/>
        <Setter Property="FontAttributes" Value="None"/>
    </Style>

    <Style x:Key="SidebarGroupLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="CharacterSpacing" Value="0.8"/>
        <Setter Property="Margin" Value="14,16,8,6"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SidebarMutedLight}, Dark={StaticResource SidebarMutedDark}}"/>
    </Style>

    <Style x:Key="SidebarSection" TargetType="Label" BasedOn="{StaticResource SidebarGroupLabel}">
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="CharacterSpacing" Value="1.2"/>
        <Setter Property="Margin" Value="8,10,8,4"/>
    </Style>

    <Style x:Key="SidebarBrand" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="LineBreakMode" Value="TailTruncation"/>
        <Setter Property="MaxLines" Value="1"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
    </Style>

    <Style x:Key="SidebarBrandSubtitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineBreakMode" Value="TailTruncation"/>
        <Setter Property="MaxLines" Value="1"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource PrimaryColor}, Dark={StaticResource Primary400}}"/>
    </Style>

    <Style x:Key="SidebarIcon" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
        <Setter Property="VerticalTextAlignment" Value="Center"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SidebarTextLight}, Dark={StaticResource SidebarTextDark}}"/>
    </Style>

    <Style x:Key="SidebarMenuItem" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="LineBreakMode" Value="TailTruncation"/>
        <Setter Property="MaxLines" Value="1"/>
        <Setter Property="VerticalOptions" Value="Center"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource SidebarTextLight}, Dark={StaticResource SidebarTextDark}}"/>
    </Style>

    <Style x:Key="SidebarChildItem" TargetType="Label" BasedOn="{StaticResource SidebarMenuItem}">
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="SidebarShell" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SidebarBackgroundLight}, Dark={StaticResource SidebarBackgroundDark}}"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="VerticalOptions" Value="Fill"/>
    </Style>

    <Style x:Key="SidebarMenuRow" TargetType="Border">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="StrokeThickness" Value="0"/>
        <Setter Property="StrokeShape" Value="RoundRectangle 6"/>
        <Setter Property="HorizontalOptions" Value="Fill"/>
        <Setter Property="HeightRequest" Value="{StaticResource SidebarItemHeight}"/>
        <Setter Property="MinimumHeightRequest" Value="{StaticResource SidebarItemHeight}"/>
        <Setter Property="Padding" Value="14,0,12,0"/>
    </Style>

    <Style x:Key="SidebarChildRow" TargetType="Border" BasedOn="{StaticResource SidebarMenuRow}">
        <Setter Property="HeightRequest" Value="{StaticResource SidebarChildItemHeight}"/>
        <Setter Property="MinimumHeightRequest" Value="{StaticResource SidebarChildItemHeight}"/>
        <Setter Property="Padding" Value="26,0,12,0"/>
    </Style>

    <Style x:Key="HeaderIconButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent"/>
        <Setter Property="BorderWidth" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="OpenSansRegular"/>
        <Setter Property="FontAttributes" Value="None"/>
        <Setter Property="WidthRequest" Value="44"/>
        <Setter Property="HeightRequest" Value="44"/>
        <Setter Property="MinimumWidthRequest" Value="44"/>
        <Setter Property="MinimumHeightRequest" Value="44"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
    </Style>

    <!-- Headline (legacy compat) -->
    <Style x:Key="Headline" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
    </Style>

    <Style x:Key="SubHeadline" TargetType="Label">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource MidnightBlue}, Dark={StaticResource White}}"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="HorizontalOptions" Value="Center"/>
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
