<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AveroNova.App.UI.Controls.Inputs.AppEntry"
    x:Name="This">

    <VerticalStackLayout Spacing="6">

        <!-- Field Label -->
        <Label
            Text="{Binding Label, Source={x:Reference This}}"
            FontSize="13"
            FontAttributes="Bold"
            TextColor="{StaticResource TextPrimary}"
            IsVisible="{Binding HasLabel, Source={x:Reference This}}" />

        <!-- Input Border -->
        <Border
            x:Name="InputBorder"
            Style="{StaticResource AuthField}">

            <Entry
                x:Name="EntryControl"
                Text="{Binding Text, Source={x:Reference This}, Mode=TwoWay}"
                Placeholder="{Binding Placeholder, Source={x:Reference This}}"
                PlaceholderColor="{StaticResource Gray400}"
                Keyboard="{Binding Keyboard, Source={x:Reference This}}"
                IsPassword="{Binding IsPassword, Source={x:Reference This}}"
                IsReadOnly="{Binding IsReadOnly, Source={x:Reference This}}"
                BackgroundColor="Transparent"
                FontSize="14"
                TextColor="{StaticResource TextPrimary}"
                HeightRequest="50"
                VerticalOptions="Center"
                ClearButtonVisibility="Never" />

        </Border>

        <!-- Error Message -->
        <Label
            Text="{Binding ErrorMessage, Source={x:Reference This}}"
            FontSize="11"
            TextColor="{StaticResource ErrorColor}"
            IsVisible="{Binding HasError, Source={x:Reference This}}"
            Margin="2,0,0,0" />

    </VerticalStackLayout>

</ContentView>
