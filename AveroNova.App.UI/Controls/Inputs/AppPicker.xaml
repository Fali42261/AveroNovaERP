<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="AveroNova.App.UI.Controls.Inputs.AppPicker"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="This">

    <VerticalStackLayout Spacing="6">

        <!-- Label -->
        <Label
            Text="{Binding Label, Source={x:Reference This}}"
            FontSize="13"
            FontAttributes="Bold"
            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

        <!-- Picker -->
        <Border Style="{StaticResource AuthField}">
            <Picker
                x:Name="PickerControl"
                ItemsSource="{Binding ItemsSource, Source={x:Reference This}}"
                SelectedItem="{Binding SelectedItem, Source={x:Reference This}, Mode=TwoWay}"
                FontSize="14"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                BackgroundColor="Transparent" />
        </Border>

        <!-- Error -->
        <Label
            Text="{Binding ErrorMessage, Source={x:Reference This}}"
            FontSize="12"
            TextColor="{StaticResource ErrorColor}"
            IsVisible="{Binding HasError, Source={x:Reference This}}" />

    </VerticalStackLayout>

</ContentView>