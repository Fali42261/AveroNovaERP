<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AveroNova.App.UI.Controls.Inputs.AppPasswordEntry"
    x:Name="This">

    <VerticalStackLayout Spacing="6">

        <!-- Field Label -->
        <Label
            Text="{Binding Label, Source={x:Reference This}}"
            FontSize="13"
            FontAttributes="Bold"
            TextColor="{StaticResource TextPrimary}"
            IsVisible="{Binding HasLabel, Source={x:Reference This}}" />

        <!-- Input Border -->
        <Border
            x:Name="InputBorder"
            BackgroundColor="{StaticResource CardBackground}"
            Stroke="{StaticResource BorderColor}"
            StrokeThickness="1.5"
            StrokeShape="RoundRectangle 10"
            Padding="14,0"
            MinimumHeightRequest="50">

            <Grid ColumnDefinitions="*,44" VerticalOptions="Fill">

                <!-- Password Entry -->
                <Entry
                    x:Name="PasswordEntryControl"
                    Grid.Column="0"
                    Text="{Binding Text, Source={x:Reference This}, Mode=TwoWay}"
                    Placeholder="{Binding Placeholder, Source={x:Reference This}}"
                    PlaceholderColor="{StaticResource Gray400}"
                    IsPassword="{Binding IsPasswordVisible, Source={x:Reference This}, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="Transparent"
                    FontSize="14"
                    TextColor="{StaticResource TextPrimary}"
                    HeightRequest="50"
                    VerticalOptions="Center"
                    ReturnType="Done"
                    ClearButtonVisibility="Never" />

                <!-- Show/Hide Toggle — 44×44 touch target -->
                <Label
                    x:Name="EyeIcon"
                    Grid.Column="1"
                    Text="&#x1F441;"
                    FontSize="18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    TextColor="{StaticResource TextSecondary}"
                    MinimumWidthRequest="44"
                    MinimumHeightRequest="44">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTogglePassword" />
                    </Label.GestureRecognizers>
                </Label>

            </Grid>

        </Border>

        <!-- Validation Error -->
        <Label
            x:Name="ErrorLabel"
            Text="{Binding ErrorMessage, Source={x:Reference This}}"
            FontSize="11"
            TextColor="{StaticResource ErrorColor}"
            IsVisible="{Binding HasError, Source={x:Reference This}}"
            Margin="2,0,0,0" />

    </VerticalStackLayout>

</ContentView>
