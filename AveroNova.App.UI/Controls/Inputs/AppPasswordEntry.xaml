<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AveroNova.App.UI.Controls.Inputs.AppPasswordEntry"
    x:Name="This">

    <VerticalStackLayout Spacing="6">

        <Label
            Text="{Binding Label, Source={x:Reference This}}"
            Style="{StaticResource InputLabel}"
            IsVisible="{Binding HasLabel, Source={x:Reference This}}" />

        <Border x:Name="InputBorder" Style="{StaticResource AuthField}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                <Label Text="{StaticResource IconAuthLock}" Style="{StaticResource AuthFieldIcon}" />
                <Entry
                    x:Name="PasswordEntryControl"
                    Grid.Column="1"
                    Text="{Binding Text, Source={x:Reference This}, Mode=TwoWay}"
                    Placeholder="{Binding Placeholder, Source={x:Reference This}}"
                    IsPassword="{Binding IsPasswordVisible, Source={x:Reference This}, Converter={StaticResource InverseBoolConverter}}"
                    BackgroundColor="Transparent"
                    FontSize="14"
                    VerticalOptions="Center"
                    ReturnType="Done"
                    ClearButtonVisibility="Never" />
                <Label
                    x:Name="EyeIcon"
                    Grid.Column="2"
                    Text="{StaticResource IconAuthEye}"
                    Style="{StaticResource AuthFieldIcon}"
                    MinimumWidthRequest="44"
                    MinimumHeightRequest="44">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTogglePassword" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </Border>

        <Label
            x:Name="ErrorLabel"
            Text="{Binding ErrorMessage, Source={x:Reference This}}"
            Style="{StaticResource ErrorText}"
            IsVisible="{Binding HasError, Source={x:Reference This}}" />

    </VerticalStackLayout>
</ContentView>
