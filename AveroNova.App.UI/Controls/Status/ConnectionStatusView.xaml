<?xml version="1.0" encoding="utf-8" ?>
<!--
    ConnectionStatusView — compact connectivity pill used in headers.
    Displays: ● Online | ● Offline | ↻ Syncing | ✓ Synced | ! Failed | 3 Pending
-->
<ContentView
    x:Class="AveroNova.App.UI.Controls.Status.ConnectionStatusView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border x:Name="Container"
            BackgroundColor="{StaticResource SuccessBg}"
            Stroke="{StaticResource SuccessBorder}"
            StrokeThickness="1" StrokeShape="RoundRectangle 20"
            Padding="10,4">
        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
            <BoxView x:Name="Dot"
                     WidthRequest="7" HeightRequest="7" CornerRadius="4"
                     BackgroundColor="{StaticResource StatusOnline}"
                     VerticalOptions="Center"/>
            <Label x:Name="LblStatus" Text="Online"
                   FontSize="11" FontAttributes="Bold"
                   TextColor="{StaticResource SuccessText}"
                   VerticalOptions="Center"/>
        </HorizontalStackLayout>
    </Border>

</ContentView>
