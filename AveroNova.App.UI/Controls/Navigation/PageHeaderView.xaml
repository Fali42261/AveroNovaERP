<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AveroNova.App.UI.Controls.Navigation.PageHeaderView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid RowDefinitions="Auto,Auto" Padding="0,0,0,16" RowSpacing="8">
        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
            <Label x:Name="LblTitle" Style="{StaticResource PageTitle}" FontSize="{StaticResource FontSizeTitle}" LineBreakMode="WordWrap" />
            <Label x:Name="LblSubtitle" Style="{StaticResource SecondaryText}" IsVisible="False" LineBreakMode="WordWrap" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout x:Name="ActionsContainer" Spacing="8" VerticalOptions="Center" />
        </ScrollView>
    </Grid>
</ContentView>
