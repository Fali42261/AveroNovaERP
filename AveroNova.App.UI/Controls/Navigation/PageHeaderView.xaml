<?xml version="1.0" encoding="utf-8" ?>
<!--
    PageHeaderView — standard page header for content pages.
    Shows title, optional subtitle, and action buttons.
-->
<ContentView
    x:Class="AveroNova.App.UI.Controls.Navigation.PageHeaderView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid ColumnDefinitions="*,Auto" Padding="0,0,0,16">

        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
            <Label x:Name="LblTitle" FontSize="22" FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
            <Label x:Name="LblSubtitle" FontSize="12"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                   IsVisible="False"/>
        </VerticalStackLayout>

        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center"
                               x:Name="ActionsContainer"/>

    </Grid>

</ContentView>
