<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AveroNova.App.UI.Controls.State.LoadingView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid HorizontalOptions="Center" VerticalOptions="Center" Padding="32">
        <VerticalStackLayout Spacing="16" HorizontalOptions="Center">
            <ActivityIndicator IsRunning="True" Color="{StaticResource PrimaryColor}"
                               WidthRequest="40" HeightRequest="40"
                               HorizontalOptions="Center"/>
            <Label x:Name="LblMessage" Text="Loading..."
                   FontSize="14" TextColor="{StaticResource TextSecondary}"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </Grid>

</ContentView>
