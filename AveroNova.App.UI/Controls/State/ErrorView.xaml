<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="AveroNova.App.UI.Controls.State.ErrorView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Grid HorizontalOptions="Center" VerticalOptions="Center" Padding="32">
        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">

            <Border WidthRequest="72" HeightRequest="72"
                    BackgroundColor="{StaticResource ErrorBg}"
                    StrokeThickness="0" StrokeShape="RoundRectangle 36"
                    HorizontalOptions="Center">
                <Label Text="&#x26D4;" FontSize="32"
                       HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <Label x:Name="LblTitle" Text="Something went wrong"
                   FontSize="16" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center"/>

            <Label x:Name="LblMessage" Text="Unable to load data. Please try again."
                   FontSize="13" TextColor="{StaticResource TextSecondary}"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"/>

            <Button x:Name="BtnRetry" Text="Retry"
                    Style="{StaticResource SmallButton}"
                    HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </Grid>

</ContentView>
