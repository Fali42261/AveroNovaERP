<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="AveroNova.App.UI.Pages.Purchases.SuppliersListPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Shell.NavBarIsVisible="False" BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">
  <Grid RowDefinitions="Auto,*">
    <Border Padding="20,14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}" Stroke="{StaticResource BorderColor}" StrokeThickness="1">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"><Button Text="&#x2190;" Style="{StaticResource GhostButton}" WidthRequest="40" Clicked="OnBackClicked"/><VerticalStackLayout Grid.Column="1"><Label Text="Suppliers" FontSize="20" FontAttributes="Bold"/><Label x:Name="LblCount" FontSize="12" TextColor="{StaticResource TextSecondary}"/></VerticalStackLayout><Button Grid.Column="2" Text="+ New Supplier" Style="{StaticResource PrimaryButton}" Clicked="OnNewClicked"/></Grid>
    </Border>
    <RefreshView Grid.Row="1" x:Name="Refresher" Refreshing="OnRefreshing"><ScrollView><VerticalStackLayout x:Name="List" Padding="16,12" Spacing="10"/></ScrollView></RefreshView>
  </Grid>
</ContentPage>
