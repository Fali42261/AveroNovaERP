<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="AveroNova.App.UI.Pages.Purchases.SupplierFormPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Shell.NavBarIsVisible="False" BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">
 <Grid RowDefinitions="Auto,*,Auto"><Border Padding="20,14" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource BorderColor}"><Grid ColumnDefinitions="Auto,*"><Button Text="&#x2190;" Style="{StaticResource GhostButton}" WidthRequest="40" Clicked="OnBackClicked"/><Label Grid.Column="1" x:Name="LblTitle" Text="New Supplier" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/></Grid></Border>
 <ScrollView Grid.Row="1"><VerticalStackLayout Padding="20,16" Spacing="12" MaximumWidthRequest="760"><Border Style="{StaticResource AppCard}"><VerticalStackLayout Spacing="10"><Label Text="Name *" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryName"/></Border><Label Text="Email" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryEmail" Keyboard="Email"/></Border><Label Text="Phone" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryPhone" Keyboard="Telephone"/></Border><Label Text="Address" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryAddress"/></Border><Label Text="Tax Number" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryTaxNumber"/></Border><Label Text="Notes" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><Editor x:Name="EditorNotes" AutoSize="TextChanges"/></Border><HorizontalStackLayout Spacing="10"><Label Text="Active" VerticalOptions="Center"/><Switch x:Name="ActiveSwitch" IsToggled="True"/></HorizontalStackLayout></VerticalStackLayout></Border><Border x:Name="ErrorBanner" IsVisible="False" BackgroundColor="{StaticResource ErrorBg}" Stroke="{StaticResource ErrorBorder}" Padding="12"><Label x:Name="LblError" TextColor="{StaticResource ErrorText}"/></Border></VerticalStackLayout></ScrollView>
 <Border Grid.Row="2" Padding="20,12" BackgroundColor="{StaticResource SurfaceColor}" Stroke="{StaticResource BorderColor}"><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><Button Text="Cancel" Style="{StaticResource SecondaryButton}" Clicked="OnBackClicked"/><Button Grid.Column="1" Text="Save Supplier" Style="{StaticResource PrimaryButton}" Clicked="OnSaveClicked"/></Grid></Border></Grid>
</ContentPage>
