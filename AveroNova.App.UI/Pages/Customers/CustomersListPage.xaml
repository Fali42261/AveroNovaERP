<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.Customers.CustomersListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:customers="clr-namespace:AveroNova.App.UI.Views.Customers"
    xmlns:state="clr-namespace:AveroNova.App.UI.Controls.State"
    xmlns:vm="clr-namespace:AveroNova.App.UI.ViewModels"
    x:DataType="vm:CustomersViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">

    <Grid x:Name="Root">

        <Grid x:Name="ListPanel" RowDefinitions="Auto,*,Auto">

            <Border
                Padding="16,12"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"
                StrokeThickness="1">
                <Grid
                    x:Name="ToolbarGrid"
                    ColumnDefinitions="Auto,Auto,Auto"
                    RowDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="12"
                    RowSpacing="10">

                    <VerticalStackLayout
                        x:Name="SearchHost"
                        Spacing="0"
                        WidthRequest="520"
                        VerticalOptions="Start"
                        HorizontalOptions="Start">
                        <Label Text="Search" Style="{StaticResource InputLabel}" />
                        <Border
                            Style="{StaticResource InputContainer}"
                            HeightRequest="42"
                            MinimumHeightRequest="42"
                            MaximumHeightRequest="44"
                            Padding="12,0"
                            VerticalOptions="Center"
                            HorizontalOptions="Fill">
                            <Grid
                                ColumnDefinitions="Auto,*"
                                ColumnSpacing="8"
                                HeightRequest="42"
                                VerticalOptions="Center"
                                IsClippedToBounds="True">
                                <Label
                                    Text="{StaticResource IconSearch}"
                                    Style="{StaticResource AuthFieldIcon}"
                                    FontSize="14"
                                    WidthRequest="18"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center" />
                                <Entry
                                    Grid.Column="1"
                                    Placeholder="Name, mobile, or email"
                                    Text="{Binding SearchText, Mode=TwoWay}"
                                    BackgroundColor="Transparent"
                                    FontSize="13"
                                    HeightRequest="42"
                                    MinimumHeightRequest="40"
                                    VerticalOptions="Fill"
                                    VerticalTextAlignment="Center"
                                    IsEnabled="{Binding IsDeleting, Converter={StaticResource InverseBoolConverter}}"
                                    SemanticProperties.Description="Search customers by name, mobile, or email" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        x:Name="StatusHost"
                        Grid.Column="1"
                        Spacing="0"
                        WidthRequest="180"
                        MinimumWidthRequest="160"
                        MaximumWidthRequest="200"
                        VerticalOptions="Start"
                        HorizontalOptions="Start">
                        <Label Text="Status" Style="{StaticResource InputLabel}" />
                        <Border
                            x:Name="StatusField"
                            Style="{StaticResource InputContainer}"
                            HeightRequest="42"
                            MinimumHeightRequest="42"
                            MaximumHeightRequest="44"
                            Padding="12,0"
                            VerticalOptions="Center"
                            HorizontalOptions="Fill">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnStatusFieldTapped" />
                            </Border.GestureRecognizers>
                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8"
                                HeightRequest="42"
                                VerticalOptions="Center"
                                InputTransparent="True"
                                IsClippedToBounds="True">
                                <Label
                                    Text="{Binding SelectedStatusFilter}"
                                    FontSize="13"
                                    MaxLines="1"
                                    LineBreakMode="TailTruncation"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center"
                                    HorizontalOptions="Fill"
                                    InputTransparent="True"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                                    SemanticProperties.Description="Customer status filter" />
                                <Label
                                    Grid.Column="1"
                                    Text="{StaticResource IconExpand}"
                                    FontSize="10"
                                    WidthRequest="14"
                                    HorizontalOptions="End"
                                    HorizontalTextAlignment="Center"
                                    VerticalOptions="Center"
                                    VerticalTextAlignment="Center"
                                    InputTransparent="True"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        x:Name="ActionHost"
                        Grid.Column="2"
                        Spacing="0"
                        VerticalOptions="Start"
                        HorizontalOptions="Start"
                        IsVisible="{Binding ShowAddButton}">
                        <Label
                            x:Name="ActionLabel"
                            Text="Action"
                            Style="{StaticResource InputLabel}" />
                        <Button
                            Text="+ Add Customer"
                            Style="{StaticResource PrimaryButton}"
                            HeightRequest="42"
                            MinimumHeightRequest="42"
                            MaximumHeightRequest="44"
                            MinimumWidthRequest="0"
                            Padding="16,0"
                            FontSize="13"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            Command="{Binding AddCommand}"
                            IsEnabled="{Binding CanPressAdd}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <state:LoadingView
                    IsVisible="{Binding ShowLoading}"
                    Message="Loading customers..." />

                <state:ErrorView
                    x:Name="ErrorState"
                    IsVisible="{Binding ShowError}"
                    Title="Unable to load customers."
                    Message="Please try again." />

                <state:EmptyView
                    x:Name="EmptyState"
                    IsVisible="{Binding ShowEmpty}"
                    Title="{Binding EmptyTitle}"
                    Subtitle="{Binding EmptySubtitle}"
                    ActionLabel="{Binding EmptyActionLabel}" />

                <RefreshView
                    IsVisible="{Binding ShowList}"
                    Refreshing="OnRefreshing">
                    <ScrollView>
                        <VerticalStackLayout
                            x:Name="ListHost"
                            Padding="16,12"
                            Spacing="10" />
                    </ScrollView>
                </RefreshView>
            </Grid>

            <Border
                Grid.Row="2"
                Padding="16,12"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"
                StrokeThickness="1"
                IsVisible="{Binding ShowPagination}">
                <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                    <Label
                        Text="{Binding ShowingLabel}"
                        FontSize="12"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    <HorizontalStackLayout
                        Spacing="8"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Button
                            Text="Previous"
                            Style="{StaticResource LightSecondaryButton}"
                            HeightRequest="42"
                            MinimumHeightRequest="40"
                            MinimumWidthRequest="0"
                            Padding="16,0"
                            FontSize="13"
                            HorizontalOptions="Start"
                            Command="{Binding PreviousCommand}"
                            IsEnabled="{Binding CanGoPrevious}" />
                        <Border
                            HeightRequest="42"
                            MinimumHeightRequest="40"
                            MinimumWidthRequest="72"
                            Padding="16,0"
                            Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource CardBackgroundDark}}"
                            VerticalOptions="Center">
                            <Label
                                Text="{Binding RangeLabel}"
                                FontSize="13"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </Border>
                        <Button
                            Text="Next"
                            Style="{StaticResource LightSecondaryButton}"
                            HeightRequest="42"
                            MinimumHeightRequest="40"
                            MinimumWidthRequest="0"
                            Padding="16,0"
                            FontSize="13"
                            HorizontalOptions="Start"
                            Command="{Binding NextCommand}"
                            IsEnabled="{Binding CanGoNext}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <customers:CustomerFormView
            x:Name="FormView"
            IsVisible="False" />

        <customers:CustomerDetailsView
            x:Name="DetailsView"
            IsVisible="False" />

        <Grid
            x:Name="StatusDropdownLayer"
            IsVisible="False"
            ZIndex="20">
            <BoxView
                Color="#01000000"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnStatusDropdownDismissed" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border
                x:Name="StatusDropdown"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                Padding="6"
                StrokeThickness="1"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}">
                <Border.Shadow>
                    <Shadow
                        Brush="#111827"
                        Opacity="0.16"
                        Radius="12"
                        Offset="0,4" />
                </Border.Shadow>
                <VerticalStackLayout
                    x:Name="StatusDropdownItems"
                    Spacing="2" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>
