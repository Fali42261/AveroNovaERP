<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="AveroNova.App.UI.Pages.Payments.PaymentViewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False" BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="20,14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="&#x2190;" Style="{StaticResource GhostButton}" Padding="0" WidthRequest="40" Clicked="OnBackClicked"/>
                <Label Grid.Column="1" Text="Payment Details" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/>
                <HorizontalStackLayout Grid.Column="2" Spacing="8"><Button Text="Edit" Style="{StaticResource SmallSecondaryButton}" HeightRequest="36" Padding="14,0" Clicked="OnEditClicked"/><Button Text="Delete" Style="{StaticResource DangerButton}" HeightRequest="36" Padding="14,0" FontSize="12" Clicked="OnDeleteClicked"/></HorizontalStackLayout>
            </Grid>
        </Border>
        <ScrollView Grid.Row="1"><VerticalStackLayout Padding="20,16" Spacing="14" x:Name="Content"/></ScrollView>
    </Grid>
</ContentPage>
