<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="AveroNova.App.UI.Pages.Payments.PaymentFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Padding="20,14"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*">
                <Button Text="&#x2190;" Style="{StaticResource GhostButton}" Padding="0" WidthRequest="40" Clicked="OnBackClicked"/>
                <Label Grid.Column="1" Text="Record Payment" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
            </Grid>
        </Border>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16" Spacing="16">
                <Border Style="{StaticResource AppCard}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Payment Details" FontSize="14" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                        <BoxView Style="{StaticResource Divider}"/>
                        <Label Text="Customer / Supplier Name *" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryParty" Placeholder="Customer or supplier name"/></Border>
                        <Label Text="Invoice Number" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryInvoice" Placeholder="INV-2026-001"/></Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Amount *" Style="{StaticResource InputLabel}"/>
                                <Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryAmount" Placeholder="0.00" Keyboard="Numeric"/></Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Payment Date" Style="{StaticResource InputLabel}"/>
                                <Border Style="{StaticResource InputContainer}"><DatePicker x:Name="DatePayment" Format="dd MMM yyyy"/></Border>
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="Payment Method *" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}">
                            <Picker x:Name="MethodPicker" Title="Select method...">
                                <Picker.Items><x:String>Cash</x:String><x:String>Bank Transfer</x:String><x:String>Credit Card</x:String><x:String>Debit Card</x:String><x:String>Cheque</x:String><x:String>Online</x:String></Picker.Items>
                            </Picker>
                        </Border>
                        <Label Text="Reference" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryRef" Placeholder="Transaction reference"/></Border>
                        <Label Text="Notes" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}" HeightRequest="80">
                            <Editor x:Name="EditorNotes" Placeholder="Optional notes..." AutoSize="TextChanges"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="ErrorBanner" IsVisible="False"
                        BackgroundColor="{StaticResource ErrorBg}" Stroke="{StaticResource ErrorBorder}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="14,10">
                    <Label x:Name="LblError" FontSize="13" TextColor="{StaticResource ErrorText}" LineBreakMode="WordWrap"/>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="2" Padding="20,12"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" StrokeThickness="1">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Cancel" Style="{StaticResource SecondaryButton}" Clicked="OnBackClicked"/>
                <Button Grid.Column="1" Text="Save Payment" Style="{StaticResource PrimaryButton}" Clicked="OnSaveClicked"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
