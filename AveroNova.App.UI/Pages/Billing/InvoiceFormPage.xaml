<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="AveroNova.App.UI.Pages.Billing.InvoiceFormPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Shell.NavBarIsVisible="False" BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Padding="20,14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*"><Button Text="&#x2190;" Style="{StaticResource GhostButton}" Padding="0" WidthRequest="40" Clicked="OnBackClicked"/><Label Grid.Column="1" x:Name="LblTitle" Text="New Sale" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/></Grid>
        </Border>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16" Spacing="16">
                <Border Style="{StaticResource AppCard}"><VerticalStackLayout Spacing="14">
                    <Label Text="Sale Details" FontSize="14" FontAttributes="Bold"/><BoxView Style="{StaticResource Divider}"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4"><Label Text="Invoice Number" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><Label x:Name="LblInvoiceNumber" Text="Auto-generated" FontSize="14" VerticalOptions="Center" Margin="0,12,0,12" TextColor="{StaticResource TextSecondary}"/></Border></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Sale Date *" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><DatePicker x:Name="DateInvoice" Format="dd MMM yyyy"/></Border></VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4"><Label Text="Due Date" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><DatePicker x:Name="DateDue" Format="dd MMM yyyy"/></Border></VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Payment Method" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><Picker x:Name="PaymentMethodPicker" Title="Select..."><Picker.Items><x:String>Cash</x:String><x:String>Bank Transfer</x:String><x:String>Credit Card</x:String><x:String>Cheque</x:String><x:String>Online</x:String></Picker.Items></Picker></Border></VerticalStackLayout>
                    </Grid>
                    <Label Text="Customer *" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><Picker x:Name="CustomerPicker" Title="Select customer..."/></Border>
                </VerticalStackLayout></Border>

                <Border Style="{StaticResource AppCard}"><VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto"><Label Text="Sale Items" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/><Button Grid.Column="1" Text="+ Add Item" Style="{StaticResource SmallButton}" Clicked="OnAddLineItem"/></Grid>
                    <BoxView Style="{StaticResource Divider}"/>
                    <Grid ColumnDefinitions="2*,Auto,Auto,Auto" ColumnSpacing="8"><Label Text="Product" Style="{StaticResource InputLabel}"/><Label Grid.Column="1" Text="Qty" Style="{StaticResource InputLabel}"/><Label Grid.Column="2" Text="Price" Style="{StaticResource InputLabel}"/><Label Grid.Column="3" Text="Total" Style="{StaticResource InputLabel}"/></Grid>
                    <Border Style="{StaticResource InputContainer}"><Picker x:Name="ProductPicker" Title="Select product..." SelectedIndexChanged="OnProductChanged"/></Border>
                    <Label x:Name="LblSelectedProduct" IsVisible="False" FontSize="12" TextColor="{StaticResource TextSecondary}" LineBreakMode="WordWrap"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"><Label Text="Quantity" Style="{StaticResource InputLabel}" VerticalOptions="Center"/><Border Grid.Column="1" Style="{StaticResource InputContainer}" HeightRequest="42"><Entry x:Name="EntryQuantity" Text="1" Keyboard="Numeric" FontSize="13"/></Border></Grid>
                    <VerticalStackLayout x:Name="LineItemsContainer" Spacing="8"/>
                    <Label x:Name="LblNoItems" Text="No items added. Select a product and click + Add Item to start the sale." FontSize="13" TextColor="{StaticResource TextSecondary}" HorizontalOptions="Center" IsVisible="True"/>
                    <BoxView Style="{StaticResource Divider}"/>
                    <Grid ColumnDefinitions="*,Auto" Padding="0,4"><Label Text="Subtotal" FontSize="13" TextColor="{StaticResource TextSecondary}"/><Label Grid.Column="1" x:Name="LblSubtotal" Text="$0.00" FontSize="13" FontAttributes="Bold"/></Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,4" ColumnSpacing="8"><Label Text="Discount %" FontSize="13" TextColor="{StaticResource TextSecondary}"/><Border Grid.Column="1" Style="{StaticResource InputContainer}" HeightRequest="36" WidthRequest="70"><Entry x:Name="EntryDiscount" Text="0" Keyboard="Numeric" FontSize="13" TextChanged="OnTotalsChanged"/></Border><Label Grid.Column="2" x:Name="LblDiscount" Text="-$0.00" FontSize="13" FontAttributes="Bold"/></Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,4" ColumnSpacing="8"><Label Text="Tax %" FontSize="13" TextColor="{StaticResource TextSecondary}"/><Border Grid.Column="1" Style="{StaticResource InputContainer}" HeightRequest="36" WidthRequest="70"><Entry x:Name="EntryTax" Text="0" Keyboard="Numeric" FontSize="13" TextChanged="OnTotalsChanged"/></Border><Label Grid.Column="2" x:Name="LblTax" Text="+$0.00" FontSize="13" FontAttributes="Bold"/></Grid>
                    <BoxView Style="{StaticResource Divider}"/><Grid ColumnDefinitions="*,Auto" Padding="0,4"><Label Text="Grand Total" FontSize="15" FontAttributes="Bold"/><Label Grid.Column="1" x:Name="LblGrandTotal" Text="$0.00" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource PrimaryColor}"/></Grid>
                </VerticalStackLayout></Border>

                <Border Style="{StaticResource AppCard}"><VerticalStackLayout Spacing="8"><Label Text="Notes" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}" HeightRequest="80"><Editor x:Name="EditorNotes" Placeholder="Optional notes for the customer..." AutoSize="TextChanges"/></Border></VerticalStackLayout></Border>
                <Border x:Name="ErrorBanner" IsVisible="False" BackgroundColor="{StaticResource ErrorBg}" Stroke="{StaticResource ErrorBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="14,10"><Label x:Name="LblError" FontSize="13" TextColor="{StaticResource ErrorText}" LineBreakMode="WordWrap"/></Border>
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="2" Padding="20,12" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" StrokeThickness="1"><Grid ColumnDefinitions="*,*" ColumnSpacing="12"><Button Text="Save Draft" Style="{StaticResource SecondaryButton}" Clicked="OnSaveDraftClicked"/><Button Grid.Column="1" Text="Save &amp; Send" Style="{StaticResource PrimaryButton}" Clicked="OnSaveClicked"/></Grid></Border>
    </Grid>
</ContentPage>
