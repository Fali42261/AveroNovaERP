<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.Products.ProductFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Padding="20,14"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*">
                <Button Text="&#x2190;" Style="{StaticResource GhostButton}" Padding="0" WidthRequest="40" Clicked="OnBackClicked"/>
                <Label Grid.Column="1" x:Name="LblTitle" Text="Add Product" FontSize="18" FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16" Spacing="16">
                <Border Style="{StaticResource AppCard}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Product Information" FontSize="14" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                        <BoxView Style="{StaticResource Divider}"/>
                        <Label Text="Product Name *" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryName" Placeholder="Product name"/></Border>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4"><Label Text="SKU" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="EntrySku" Placeholder="SKU-001"/></Border></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Barcode" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryBarcode" Placeholder="0000000000000"/></Border></VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4"><Label Text="Category" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryCategory" Placeholder="Electronics"/></Border></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Brand" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryBrand" Placeholder="Brand"/></Border></VerticalStackLayout>
                        </Grid>
                        <Label Text="Unit" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryUnit" Placeholder="pcs"/></Border>
                        <Label Text="Description" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}" HeightRequest="80" VerticalOptions="Start">
                            <Editor x:Name="EditorDesc" Placeholder="Product description..." AutoSize="TextChanges"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AppCard}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Pricing &amp; Stock" FontSize="14" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                        <BoxView Style="{StaticResource Divider}"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4"><Label Text="Purchase Price" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryPurchasePrice" Placeholder="0.00" Keyboard="Numeric"/></Border></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Selling Price *" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="EntrySellingPrice" Placeholder="0.00" Keyboard="Numeric"/></Border></VerticalStackLayout>
                        </Grid>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4"><Label Text="Tax %" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryTax" Placeholder="10" Keyboard="Numeric"/></Border></VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4"><Label Text="Stock" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryStock" Placeholder="0" Keyboard="Numeric"/></Border></VerticalStackLayout>
                        </Grid>
                        <Label Text="Minimum Stock" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryMinStock" Placeholder="5" Keyboard="Numeric"/></Border>
                    </VerticalStackLayout>
                </Border>

                <Border x:Name="ErrorBanner" IsVisible="False"
                        BackgroundColor="{StaticResource ErrorBg}" Stroke="{StaticResource ErrorBorder}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="14,10">
                    <Label x:Name="LblError" FontSize="13" TextColor="{StaticResource ErrorText}" LineBreakMode="WordWrap"/>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" Padding="20,12"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" StrokeThickness="1">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Cancel" Style="{StaticResource SecondaryButton}" Clicked="OnBackClicked"/>
                <Button Grid.Column="1" Text="Save Product" Style="{StaticResource PrimaryButton}" Clicked="OnSaveClicked"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
