<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.Inventory.InventoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">
    <Grid x:Name="Root" RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Padding="20,14" StrokeThickness="1">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Inventory" FontSize="20" FontAttributes="Bold" />
                    <Label x:Name="LblCount" Text="0 items" FontSize="12" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Stock History" Margin="0,0,8,0" Clicked="OnHistoryClicked" />
                <Button Grid.Column="2" Text="Adjust Stock" HeightRequest="40" FontSize="13" Clicked="OnAdjustClicked" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Padding="16,10" StrokeThickness="1">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                <VerticalStackLayout HorizontalOptions="Center" Spacing="2"><Label x:Name="LblTotalItems" Text="0" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/><Label Text="Total Items" FontSize="10" HorizontalOptions="Center"/></VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2"><Label x:Name="LblLowStock" Text="0" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/><Label Text="Low Stock" FontSize="10" HorizontalOptions="Center"/></VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2"><Label x:Name="LblInStock" Text="0" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/><Label Text="In Stock" FontSize="10" HorizontalOptions="Center"/></VerticalStackLayout>
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="2"><Label x:Name="LblOutOfStock" Text="0" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center"/><Label Text="Out of Stock" FontSize="10" HorizontalOptions="Center"/></VerticalStackLayout>
            </Grid>
        </Border>
        <RefreshView Grid.Row="2" x:Name="Refresher" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="16,12" Spacing="10" x:Name="InventoryList" />
            </ScrollView>
        </RefreshView>
        <Grid x:Name="ActionOverlay" Grid.RowSpan="3" IsVisible="False" ZIndex="50">
            <ContentView x:Name="ActionContent" HorizontalOptions="Fill" VerticalOptions="Fill" />
        </Grid>
    </Grid>
</ContentPage>
