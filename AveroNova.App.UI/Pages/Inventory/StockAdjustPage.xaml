<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.Inventory.StockAdjustPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="20,14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Button Text="&#x2190;" Style="{StaticResource GhostButton}" Padding="0" WidthRequest="40" HeightRequest="40" Clicked="OnBackClicked"/>
                <Label Grid.Column="1" Text="Stock Adjustment" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/>
            </Grid>
        </Border>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16" Spacing="16" MaximumWidthRequest="900" HorizontalOptions="Fill">
                <Border Style="{StaticResource AppCard}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Adjustment Details" FontSize="14" FontAttributes="Bold"/>
                        <BoxView Style="{StaticResource Divider}"/>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Product *" Style="{StaticResource InputLabel}"/>
                            <Border Style="{StaticResource InputContainer}" HeightRequest="44" Padding="12,0">
                                <Picker x:Name="ProductPicker" Title="Select product" HeightRequest="44" VerticalOptions="Center" HorizontalOptions="Fill"/>
                            </Border>
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Current Stock" Style="{StaticResource InputLabel}"/>
                                <Border Style="{StaticResource InputContainer}" HeightRequest="44" Padding="12,0">
                                    <Label x:Name="LblCurrentStock" Text="—" FontSize="14" VerticalOptions="Center"/>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6">
                                <Label Text="New Stock *" Style="{StaticResource InputLabel}"/>
                                <Border Style="{StaticResource InputContainer}" HeightRequest="44" Padding="12,0">
                                    <Entry x:Name="EntryNewStock" Placeholder="0" Keyboard="Numeric" HeightRequest="44" VerticalTextAlignment="Center"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Reason *" Style="{StaticResource InputLabel}"/>
                            <Border Style="{StaticResource InputContainer}" HeightRequest="44" Padding="12,0">
                                <Picker x:Name="ReasonPicker" Title="Select reason" HeightRequest="44" VerticalOptions="Center" HorizontalOptions="Fill">
                                    <Picker.Items>
                                        <x:String>Physical Count</x:String>
                                        <x:String>Damaged Goods</x:String>
                                        <x:String>Theft / Loss</x:String>
                                        <x:String>Return from Customer</x:String>
                                        <x:String>Supplier Return</x:String>
                                        <x:String>Other</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Notes" Style="{StaticResource InputLabel}"/>
                            <Border Style="{StaticResource InputContainer}" HeightRequest="88" Padding="12,8">
                                <Editor x:Name="EditorNotes" Placeholder="Optional notes" AutoSize="TextChanges"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="ErrorBanner" IsVisible="False" BackgroundColor="{StaticResource ErrorBg}" Stroke="{StaticResource ErrorBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="14,10">
                    <Label x:Name="LblError" FontSize="13" TextColor="{StaticResource ErrorText}" LineBreakMode="WordWrap"/>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        <Border Grid.Row="2" Padding="20,12" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" StrokeThickness="1">
            <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                <Button Text="Cancel" Style="{StaticResource SmallSecondaryButton}" HeightRequest="40" MinimumWidthRequest="88" Padding="16,0" Clicked="OnBackClicked"/>
                <Button Text="Apply Adjustment" Style="{StaticResource SmallButton}" HeightRequest="40" MinimumWidthRequest="132" Padding="16,0" Clicked="OnSaveClicked"/>
            </HorizontalStackLayout>
        </Border>
    </Grid>
</ContentPage>
