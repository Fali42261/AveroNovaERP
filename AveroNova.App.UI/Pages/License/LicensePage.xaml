<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.License.LicensePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AveroNova.App.UI.ViewModels"
    x:DataType="vm:LicenseViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="20,14"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"
                StrokeThickness="1">
            <VerticalStackLayout Spacing="2">
                <Label Text="License" FontSize="20" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                <Label Text="Starter trial and plan status" FontSize="12"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
            </VerticalStackLayout>
        </Border>

        <RefreshView Grid.Row="1" Command="{Binding LoadCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16,12" Spacing="16">

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="{StaticResource ErrorText}" FontSize="13"/>

                    <Border Style="{StaticResource AppCard}" Padding="20">
                        <VerticalStackLayout Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="CURRENT PLAN" FontSize="11" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                    <Label Text="{Binding PlanName}" FontSize="22" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                                </VerticalStackLayout>
                                <Border Grid.Column="1" Padding="10,4" VerticalOptions="Start"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 999"
                                        BackgroundColor="{StaticResource Primary50}">
                                    <Label Text="{Binding StatusText}" FontSize="12" FontAttributes="Bold"
                                           TextColor="{StaticResource Primary700}"/>
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"/>

                            <Label Text="{Binding RemainingText}" FontSize="16" FontAttributes="Bold"
                                   TextColor="{StaticResource Primary600}"/>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="Trial Start Date" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                    <Label Text="{Binding TrialStartText}" FontSize="14" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Trial End Date" FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                                    <Label Text="{Binding TrialEndText}" FontSize="14" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource AppCard}" Padding="20">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Business" FontSize="16" FontAttributes="Bold"/>
                                <Border Grid.Column="1" Padding="10,4" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource Gray100}">
                                    <Label Text="Coming Soon" FontSize="11" FontAttributes="Bold"
                                           TextColor="{StaticResource Gray600}"/>
                                </Border>
                            </Grid>
                            <Label Text="Additional companies, users, and commercial billing will be available in a later release."
                                   FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource AppCard}" Padding="20">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Enterprise" FontSize="16" FontAttributes="Bold"/>
                                <Border Grid.Column="1" Padding="10,4" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 999" BackgroundColor="{StaticResource Gray100}">
                                    <Label Text="Coming Soon" FontSize="11" FontAttributes="Bold"
                                           TextColor="{StaticResource Gray600}"/>
                                </Border>
                            </Grid>
                            <Label Text="Enterprise capabilities are not available for purchase yet."
                                   FontSize="13" TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
