<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.Expenses.ExpenseFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">

    <Grid RowDefinitions="Auto,*,Auto">

        <Border Grid.Row="0" Padding="20,14"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*">
                <Button Text="{StaticResource IconBack}" Style="{StaticResource GhostButton}" Padding="0" WidthRequest="40" Clicked="OnBackClicked"/>
                <Label Grid.Column="1" x:Name="LblTitle" Text="Expense Form" FontSize="18" FontAttributes="Bold"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16" Spacing="16" MaximumWidthRequest="760">
                <Border Style="{StaticResource AppCard}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Expense Details" FontSize="14" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                        <BoxView Style="{StaticResource Divider}"/>
                        <Label Text="Category *" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}"><Picker x:Name="CategoryPicker" Title="Select category" HorizontalTextAlignment="Center"/></Border>
                        <Label Text="Amount *" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryAmount" Placeholder="0.00" Keyboard="Numeric" HorizontalTextAlignment="Center"/></Border>
                        <Label Text="Date" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}"><DatePicker x:Name="DateExpense" Format="dd MMM yyyy" HorizontalOptions="Center"/></Border>
                        <Label Text="Payment Method" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}"><Picker x:Name="MethodPicker" HorizontalTextAlignment="Center"><Picker.Items><x:String>Cash</x:String><x:String>Bank Transfer</x:String><x:String>Credit Card</x:String><x:String>Debit Card</x:String><x:String>Cheque</x:String><x:String>Online</x:String><x:String>Other</x:String></Picker.Items></Picker></Border>
                        <Label Text="Status" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}"><Picker x:Name="StatusPicker" HorizontalTextAlignment="Center" SelectedIndexChanged="OnStatusChanged"><Picker.Items><x:String>Pending</x:String><x:String>Approved</x:String><x:String>Rejected</x:String><x:String>Paid</x:String></Picker.Items></Picker></Border>
                        <VerticalStackLayout x:Name="ApprovedBySection" IsVisible="False" Spacing="4"><Label Text="Approved By *" Style="{StaticResource InputLabel}"/><Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryApprovedBy" Placeholder="Approver name"/></Border></VerticalStackLayout>
                        <Label Text="Reference" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}"><Entry x:Name="EntryReference" Placeholder="Receipt or transaction reference"/></Border>
                        <Label Text="Description" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}" HeightRequest="80" VerticalOptions="Start">
                            <Editor x:Name="EditorDescription" Placeholder="Additional details..." AutoSize="TextChanges"/>
                        </Border>
                        <Label Text="Notes" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}" HeightRequest="80" VerticalOptions="Start">
                            <Editor x:Name="EditorNotes" Placeholder="Internal notes..." AutoSize="TextChanges"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>
                <Border x:Name="ErrorBanner" IsVisible="False"
                        BackgroundColor="{StaticResource ErrorBg}" Stroke="{StaticResource ErrorBorder}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="14,10">
                    <Label x:Name="LblError" FontSize="13" TextColor="{StaticResource ErrorText}" LineBreakMode="WordWrap"/>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2" Padding="20,12"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" StrokeThickness="1">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Cancel" Style="{StaticResource SecondaryButton}" Clicked="OnBackClicked"/>
                <Button Grid.Column="1" Text="Save Expense" Style="{StaticResource PrimaryButton}" Clicked="OnSaveClicked"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
