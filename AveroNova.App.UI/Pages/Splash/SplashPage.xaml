<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.Splash.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource SidebarBackground}">

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">

        <Border WidthRequest="80" HeightRequest="80"
                BackgroundColor="#1557B0" StrokeThickness="0"
                StrokeShape="RoundRectangle 20" HorizontalOptions="Center">
            <Label Text="A" FontSize="44" FontAttributes="Bold"
                   TextColor="{StaticResource Primary400}"
                   HorizontalOptions="Center" VerticalOptions="Center"/>
        </Border>

        <Label Text="AveroNova ERP" FontSize="28" FontAttributes="Bold"
               TextColor="{StaticResource White}" HorizontalOptions="Center"/>

        <ActivityIndicator IsRunning="True" Color="{StaticResource Primary400}"
                           HorizontalOptions="Center" Margin="0,16,0,0"/>

        <Label Text="Loading..." FontSize="13" TextColor="{StaticResource SidebarText}"
               HorizontalOptions="Center"/>

    </VerticalStackLayout>

</ContentPage>
