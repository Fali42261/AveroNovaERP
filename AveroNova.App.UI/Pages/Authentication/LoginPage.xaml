<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.Authentication.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:b="clr-namespace:AveroNova.App.UI.Behaviors"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">

    <ScrollView>
        <Border Style="{StaticResource AuthCard}"
                Margin="{StaticResource PaddingMedium}"
                VerticalOptions="Center"
                MaximumWidthRequest="{StaticResource AuthCardMaxWidth}"
                HorizontalOptions="Center">
            <VerticalStackLayout Spacing="0">

                <Border WidthRequest="56" HeightRequest="56"
                        BackgroundColor="{StaticResource Primary600}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        HorizontalOptions="Center">
                    <Label Text="A" FontAttributes="Bold"
                           FontSize="{StaticResource FontSizeLargeTitle}"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </Border>

                <Label Text="Sign In" Style="{StaticResource PageTitle}"
                       HorizontalOptions="Center" Margin="0,16,0,4" />
                <Label Text="Enter your credentials to access AveroNova ERP"
                       Style="{StaticResource SecondaryText}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,24" />

                <Border x:Name="ErrorBanner" IsVisible="False"
                        BackgroundColor="{StaticResource ErrorBg}"
                        Stroke="{StaticResource ErrorBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 10" Padding="14,10" Margin="0,0,0,16">
                    <Label x:Name="LblError" Style="{StaticResource ErrorText}" Margin="0" />
                </Border>

                <Label Text="Email Address" Style="{StaticResource InputLabel}" />
                <Border Style="{StaticResource InputContainer}" Margin="0,0,0,16">
                    <Entry x:Name="EntryEmail" Placeholder="you@company.com"
                           Keyboard="Email" ReturnType="Next"
                           SemanticProperties.Description="Email address" />
                </Border>

                <Label Text="Password" Style="{StaticResource InputLabel}" />
                <Border Style="{StaticResource InputContainer}" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry x:Name="EntryPassword" Placeholder="Enter your password"
                               IsPassword="True" ReturnType="Done"
                               SemanticProperties.Description="Password" />
                        <Button x:Name="BtnTogglePassword" Grid.Column="1" Text="Show"
                                Style="{StaticResource GhostButton}"
                                FontSize="{StaticResource FontSizeSmall}"
                                MinimumWidthRequest="64"
                                Clicked="OnTogglePasswordClicked" />
                    </Grid>
                </Border>

                <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center"
                            Margin="0,8,0,24">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <CheckBox x:Name="ChkRemember" Color="{StaticResource PrimaryColor}" />
                        <Label Text="Remember me" Style="{StaticResource SecondaryText}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Forgot Password?"
                           Style="{StaticResource LinkText}"
                           FontSize="{StaticResource FontSizeSmall}"
                           VerticalOptions="Center"
                           b:HandCursor.Enable="True">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </FlexLayout>

                <Button x:Name="BtnLogin" Text="Login"
                        Style="{StaticResource PrimaryButton}"
                        Clicked="OnLoginClicked" />

                <ActivityIndicator x:Name="Loader" IsRunning="False" IsVisible="False"
                                   Color="{StaticResource PrimaryColor}"
                                   HorizontalOptions="Center" Margin="0,12,0,0" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" Margin="0,24,0,0">
                    <Label Text="Don't have an account?" Style="{StaticResource SecondaryText}" />
                    <Label Text="Create New Company" Style="{StaticResource LinkText}" FontSize="{StaticResource FontSizeSmall}" b:HandCursor.Enable="True">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRegisterTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
