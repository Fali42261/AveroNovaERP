<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.Authentication.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:b="clr-namespace:AveroNova.App.UI.Behaviors"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource BackgroundColor}">

    <Grid>
        <Grid x:Name="ExpandedLayout" IsVisible="False" ColumnDefinitions="0.42*,0.58*">
            <Border BackgroundColor="{StaticResource SidebarBackground}" StrokeThickness="0">
                <ScrollView>
                    <VerticalStackLayout
                        Spacing="{StaticResource Space5}"
                        VerticalOptions="Center"
                        Padding="{StaticResource PaddingXLarge}">

                        <Border
                            WidthRequest="56" HeightRequest="56"
                            BackgroundColor="{StaticResource Primary600}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            HorizontalOptions="Start">
                            <Label Text="A" Style="{StaticResource DisplayText}"
                                   FontSize="{StaticResource FontSizeLargeTitle}"
                                   TextColor="{StaticResource White}"
                                   HorizontalOptions="Center" VerticalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                        </Border>

                        <Label Text="AveroNova ERP" Style="{StaticResource PageTitle}" TextColor="{StaticResource White}" />
                        <Label Text="ERP for Smarter Business"
                               Style="{StaticResource SectionTitle}"
                               TextColor="{StaticResource Primary300}" />
                        <Label Text="Invoicing, inventory, customers, purchases, and teams in one professional workspace."
                               Style="{StaticResource BodyText}"
                               TextColor="{StaticResource SidebarText}" />

                        <VerticalStackLayout Spacing="{StaticResource Space3}" Margin="0,12,0,0">
                            <Label Text="•  Offline-first architecture" Style="{StaticResource BodyText}" TextColor="{StaticResource SidebarText}" />
                            <Label Text="•  Real-time synchronization" Style="{StaticResource BodyText}" TextColor="{StaticResource SidebarText}" />
                            <Label Text="•  Multi-company support" Style="{StaticResource BodyText}" TextColor="{StaticResource SidebarText}" />
                            <Label Text="•  Windows, Android and iOS" Style="{StaticResource BodyText}" TextColor="{StaticResource SidebarText}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <ScrollView Grid.Column="1">
                <VerticalStackLayout
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    Padding="{StaticResource PaddingXLarge}"
                    MaximumWidthRequest="{StaticResource AuthCardMaxWidth}"
                    Spacing="{StaticResource Space4}">

                    <Label Text="Welcome to AveroNova" Style="{StaticResource PageTitle}" />
                    <Label Text="Create your account to get started."
                           Style="{StaticResource SecondaryText}" />

                    <Border x:Name="CompanyCardExpanded"
                            Style="{StaticResource SelectableCard}"
                            b:HandCursor.Enable="True">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCreateCompanyTapped" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="{StaticResource Space3}">
                            <Border WidthRequest="40" HeightRequest="40"
                                    BackgroundColor="{StaticResource Primary50}"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    VerticalOptions="Start">
                                <Label Text="✓" FontAttributes="Bold"
                                       TextColor="{StaticResource Primary600}"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       HorizontalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label Text="Create New Company" Style="{StaticResource SectionTitle}" />
                                <Label Text="Set up a new company workspace. Existing company users are added later by the owner."
                                       Style="{StaticResource CaptionText}" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>

                    <Button x:Name="BtnContinueExpanded"
                            Text="Continue →"
                            Style="{StaticResource PrimaryButton}"
                            IsEnabled="False"
                            Clicked="OnContinueClicked" />

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="Already have an account?" Style="{StaticResource SecondaryText}" />
                        <Label Text="Login" Style="{StaticResource LinkText}" b:HandCursor.Enable="True">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLoginClicked" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <ScrollView x:Name="CompactLayout">
            <VerticalStackLayout
                Margin="{StaticResource PaddingLarge}"
                MaximumWidthRequest="{StaticResource AuthCardMaxWidth}"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="{StaticResource Space4}">

                <Border
                    WidthRequest="56" HeightRequest="56"
                    BackgroundColor="{StaticResource Primary600}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    HorizontalOptions="Center">
                    <Label Text="A" FontAttributes="Bold"
                           FontSize="{StaticResource FontSizeLargeTitle}"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center" VerticalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </Border>

                <Label Text="AveroNova ERP"
                       Style="{StaticResource PageTitle}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <Label Text="ERP for Smarter Business"
                       Style="{StaticResource SectionTitle}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
                <Label Text="Invoicing, inventory, customers, purchases, and teams in one professional workspace."
                       Style="{StaticResource SecondaryText}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <Label Text="Welcome to AveroNova"
                       Style="{StaticResource PageTitle}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"
                       Margin="0,8,0,0" />
                <Label Text="Create your account to get started."
                       Style="{StaticResource SecondaryText}"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />

                <Border x:Name="CompanyCardCompact"
                        Style="{StaticResource SelectableCard}"
                        b:HandCursor.Enable="True">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCreateCompanyTapped" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Create New Company" Style="{StaticResource SectionTitle}" />
                        <Label Text="Set up a new company workspace. Existing company users are added later by the owner."
                               Style="{StaticResource CaptionText}" />
                    </VerticalStackLayout>
                </Border>

                <Button x:Name="BtnContinueCompact"
                        Text="Continue →"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="False"
                        Clicked="OnContinueClicked" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Label Text="Already have an account?" Style="{StaticResource SecondaryText}" />
                    <Label Text="Login" Style="{StaticResource LinkText}" b:HandCursor.Enable="True">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLoginClicked" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
