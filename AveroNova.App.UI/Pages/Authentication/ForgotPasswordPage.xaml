<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.Authentication.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:AveroNova.App.UI.ViewModels"
    x:DataType="vm:ForgotPasswordViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <Border Style="{StaticResource AuthCard}"
                Margin="{StaticResource PaddingMedium}"
                MaximumWidthRequest="{StaticResource AuthCardMaxWidth}"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <VerticalStackLayout Spacing="{StaticResource Space4}">

                <Button Text="Back"
                        Style="{StaticResource GhostButton}"
                        HorizontalOptions="Start"
                        Clicked="OnBackClicked"
                        IsVisible="{Binding IsSuccessStep, Converter={StaticResource InverseBoolConverter}}" />

                <Label Text="Forgot Password"
                       Style="{StaticResource PageTitle}"
                       IsVisible="{Binding IsSuccessStep, Converter={StaticResource InverseBoolConverter}}" />

                <Label Text="{Binding ErrorMessage}"
                       Style="{StaticResource ErrorText}"
                       IsVisible="{Binding HasError}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

                <VerticalStackLayout IsVisible="{Binding IsEmailStep}" Spacing="{StaticResource Space4}">
                    <Label Text="Enter the email for your account. We will send a verification code."
                           Style="{StaticResource SecondaryText}" />
                    <Label Text="Email Address *" Style="{StaticResource InputLabel}" />
                    <Border Style="{StaticResource InputContainer}">
                        <Entry Placeholder="you@company.com"
                               Keyboard="Email"
                               Text="{Binding Email, Mode=TwoWay}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsOtpStep}" Spacing="{StaticResource Space4}">
                    <Label Text="Enter the 6-digit verification code sent to your email."
                           Style="{StaticResource SecondaryText}" />
                    <Label Text="Verification Code *" Style="{StaticResource InputLabel}" />
                    <Border Style="{StaticResource InputContainer}">
                        <Entry Placeholder="123456"
                               Keyboard="Numeric"
                               MaxLength="6"
                               Text="{Binding Otp, Mode=TwoWay}"
                               HorizontalTextAlignment="Center" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsPasswordStep}" Spacing="{StaticResource Space4}">
                    <Label Text="Choose a new password."
                           Style="{StaticResource SecondaryText}" />
                    <Label Text="New Password *" Style="{StaticResource InputLabel}" />
                    <Border Style="{StaticResource InputContainer}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Placeholder="New password"
                                   Text="{Binding NewPassword, Mode=TwoWay}"
                                   IsPassword="{Binding IsPasswordHidden}" />
                            <Button Grid.Column="1"
                                    Text="{Binding ShowPasswordText}"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding TogglePasswordVisibilityCommand}" />
                        </Grid>
                    </Border>
                    <Label Text="Confirm Password *" Style="{StaticResource InputLabel}" />
                    <Border Style="{StaticResource InputContainer}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Entry Placeholder="Confirm password"
                                   Text="{Binding ConfirmPassword, Mode=TwoWay}"
                                   IsPassword="{Binding IsConfirmPasswordHidden}" />
                            <Button Grid.Column="1"
                                    Text="{Binding ShowConfirmPasswordText}"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding ToggleConfirmPasswordVisibilityCommand}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsSuccessStep}" Spacing="{StaticResource Space4}">
                    <Label Text="Password Changed Successfully"
                           Style="{StaticResource PageTitle}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                    <Label Text="You can now sign in with your new password."
                           Style="{StaticResource SecondaryText}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                    <Button Text="Go to Login"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnGoToLoginClicked" />
                </VerticalStackLayout>

                <Button Text="{Binding PrimaryButtonText}"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding NextCommand}"
                        IsVisible="{Binding IsSuccessStep, Converter={StaticResource InverseBoolConverter}}" />
            </VerticalStackLayout>
        </Border>
    </ScrollView>
</ContentPage>
