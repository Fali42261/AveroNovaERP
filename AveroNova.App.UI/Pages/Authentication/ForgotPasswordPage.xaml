<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.Authentication.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center"
                             Padding="24" Spacing="0" MaximumWidthRequest="440">

            <Button Text="&#x2190; Back" Style="{StaticResource GhostButton}"
                    HorizontalOptions="Start" Padding="0" Clicked="OnBackClicked"/>

            <Border WidthRequest="60" HeightRequest="60"
                    BackgroundColor="{StaticResource Primary50}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 30" HorizontalOptions="Center" Margin="0,24,0,0">
                <Label Text="&#x1F511;" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"/>
            </Border>

            <Label Text="Forgot Password?" FontSize="24" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}"
                   HorizontalOptions="Center" Margin="0,20,0,8"/>
            <Label Text="Enter your email address to continue with a local password reset."
                   FontSize="13" TextColor="{StaticResource TextSecondary}"
                   HorizontalOptions="Center" HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap" Margin="0,0,0,32"/>

            <!-- Success -->
            <Border x:Name="SuccessBanner" IsVisible="False"
                    BackgroundColor="{StaticResource SuccessBg}"
                    Stroke="{StaticResource SuccessBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 10" Padding="14,10" Margin="0,0,0,16">
                <Label x:Name="LblSuccess" FontSize="13" TextColor="{StaticResource SuccessText}"/>
            </Border>

            <!-- Error -->
            <Border x:Name="ErrorBanner" IsVisible="False"
                    BackgroundColor="{StaticResource ErrorBg}"
                    Stroke="{StaticResource ErrorBorder}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 10" Padding="14,10" Margin="0,0,0,16">
                <Label x:Name="LblError" FontSize="13" TextColor="{StaticResource ErrorText}"/>
            </Border>

            <Label Text="Email Address" Style="{StaticResource InputLabel}"/>
            <Border Style="{StaticResource InputContainer}" Margin="0,4,0,24">
                <Entry x:Name="EntryEmail" Placeholder="you@company.com" Keyboard="Email"/>
            </Border>

            <Button Text="Continue" Style="{StaticResource PrimaryButton}"
                    HorizontalOptions="Fill" Clicked="OnSendClicked"/>

            <ActivityIndicator x:Name="Loader" IsRunning="False" IsVisible="False"
                               Color="{StaticResource PrimaryColor}" HorizontalOptions="Center" Margin="0,12,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
