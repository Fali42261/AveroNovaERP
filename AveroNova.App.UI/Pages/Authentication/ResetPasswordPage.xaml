<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.Authentication.ResetPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:helpers="clr-namespace:AveroNova.App.UI.Helpers"
    xmlns:layout="clr-namespace:AveroNova.App.UI.Layout"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="Container"
    HideSoftInputOnTapped="True"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">

    <ScrollView
        x:Name="PageScroll"
        Orientation="Vertical"
        HorizontalScrollBarVisibility="Never"
        VerticalScrollBarVisibility="Default"
        Padding="0,0,0,8">

        <Grid
            x:Name="ContentHost"
            layout:ResponsivePage.Ignore="True"
            Padding="{StaticResource PaddingLarge}">

            <Border
                x:Name="AuthCard"
                Style="{StaticResource AuthCard}"
                VerticalOptions="Center"
                HorizontalOptions="Center"
                MaximumWidthRequest="{StaticResource AuthCardMaxWidth}">

                <VerticalStackLayout Spacing="0" HorizontalOptions="Fill">

                    <Border WidthRequest="56" HeightRequest="56"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            HorizontalOptions="Center">
                        <Label Text="SW" FontSize="28" FontAttributes="Bold"
                               TextColor="{StaticResource White}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <Label Text="Reset Password"
                           Style="{StaticResource PageTitle}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           Margin="0,20,0,4" />
                    <Label Text="Enter your email and choose a new password."
                           Style="{StaticResource SecondaryText}"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           Margin="0,0,0,28" />

                    <Border x:Name="ErrorBanner" IsVisible="False"
                            BackgroundColor="{StaticResource ErrorBg}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 10"
                            Padding="14,10"
                            Margin="0,0,0,16">
                        <Label x:Name="LblError"
                               FontSize="13"
                               TextColor="{StaticResource ErrorColor}"
                               LineBreakMode="WordWrap" />
                    </Border>

                    <Label Text="Email" Style="{StaticResource InputLabel}" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry x:Name="EntryEmail"
                               Placeholder="Enter your user email"
                               Keyboard="Email"
                               ReturnType="Next"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               SemanticProperties.Description="User email"
                               Completed="OnEmailCompleted" />
                    </Border>
                    <Label x:Name="LblEmailError"
                           FontSize="12"
                           TextColor="{StaticResource ErrorColor}"
                           IsVisible="False"
                           LineBreakMode="WordWrap"
                           Margin="0,0,0,12" />

                    <Label Text="New Password" Style="{StaticResource InputLabel}" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry x:Name="EntryPassword"
                               Placeholder="Enter new password"
                               IsPassword="True"
                               ReturnType="Next"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               SemanticProperties.Description="New password"
                               Completed="OnPasswordCompleted" />
                    </Border>
                    <Label x:Name="LblPasswordError"
                           FontSize="12"
                           TextColor="{StaticResource ErrorColor}"
                           IsVisible="False"
                           LineBreakMode="WordWrap"
                           Margin="0,0,0,12" />

                    <Label Text="Confirm Password" Style="{StaticResource InputLabel}" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry x:Name="EntryConfirm"
                               Placeholder="Re-enter new password"
                               IsPassword="True"
                               ReturnType="Done"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               SemanticProperties.Description="Confirm new password"
                               Completed="OnConfirmCompleted" />
                    </Border>
                    <Label x:Name="LblConfirmError"
                           FontSize="12"
                           TextColor="{StaticResource ErrorColor}"
                           IsVisible="False"
                           LineBreakMode="WordWrap"
                           Margin="0,0,0,24" />

                    <Button x:Name="BtnReset"
                            Text="Reset Password"
                            Style="{StaticResource PrimaryButton}"
                            helpers:CursorBehavior.Cursor="Hand"
                            Clicked="OnResetClicked" />

                    <ActivityIndicator x:Name="Loader"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="{StaticResource PrimaryColor}"
                                       HorizontalOptions="Center"
                                       Margin="0,16,0,0" />

                    <FlexLayout
                        JustifyContent="Center"
                        AlignItems="Center"
                        Wrap="Wrap"
                        Margin="0,28,0,0">
                        <Label Text="Remember your password?"
                               FontSize="13"
                               Margin="0,0,4,0"
                               TextColor="{StaticResource TextSecondary}" />
                        <Label Text="Sign In"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource PrimaryColor}"
                               helpers:CursorBehavior.Cursor="Hand">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSignInTapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
