<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.Authentication.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:nav="clr-namespace:AveroNova.App.UI.Controls.Navigation"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{StaticResource BackgroundColor}">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="{StaticResource PaddingMedium}"
                             BackgroundColor="{StaticResource CardBackground}"
                             Spacing="{StaticResource Space2}">
            <Label Text="Create your account" Style="{StaticResource SectionTitle}" />
            <Label x:Name="LblStepCaption" Text="Your details"
                   Style="{StaticResource CaptionText}" />
            <nav:StepIndicatorView x:Name="StepIndicator" Margin="0,8,0,0" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <Border Style="{StaticResource AuthCard}"
                    Margin="{StaticResource PaddingMedium}"
                    MaximumWidthRequest="{StaticResource AuthCardMaxWidth}"
                    HorizontalOptions="Center"
                    VerticalOptions="Start">

                <VerticalStackLayout Spacing="{StaticResource Space4}">

                    <Label Text="{Binding GeneralError}"
                           Style="{StaticResource ErrorText}"
                           IsVisible="{Binding HasGeneralError}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource PrimaryColor}" />

                    <VerticalStackLayout x:Name="Step1Container" Spacing="{StaticResource Space4}">
                        <Label Text="Personal information" Style="{StaticResource SectionTitle}" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Full Name *" Style="{StaticResource InputLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Placeholder="First and last name"
                                       Text="{Binding FirstName, Mode=TwoWay}"
                                       SemanticProperties.Description="Full name" />
                            </Border>
                            <Label Text="{Binding FirstNameError}"
                                   Style="{StaticResource ErrorText}"
                                   IsVisible="{Binding HasFirstNameError}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Email Address *" Style="{StaticResource InputLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Placeholder="you@company.com"
                                       Keyboard="Email"
                                       Text="{Binding Email, Mode=TwoWay}"
                                       SemanticProperties.Description="Email address" />
                            </Border>
                            <Label Text="{Binding EmailError}"
                                   Style="{StaticResource ErrorText}"
                                   IsVisible="{Binding HasEmailError}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Phone Number" Style="{StaticResource InputLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Placeholder="+1 234 567 8900"
                                       Keyboard="Telephone"
                                       Text="{Binding Phone, Mode=TwoWay}"
                                       SemanticProperties.Description="Phone number" />
                            </Border>
                            <Label Text="{Binding PhoneError}"
                                   Style="{StaticResource ErrorText}"
                                   IsVisible="{Binding HasPhoneError}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Password *" Style="{StaticResource InputLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Placeholder="Enter password"
                                           Text="{Binding Password, Mode=TwoWay}"
                                           IsPassword="{Binding IsPasswordHidden}"
                                           SemanticProperties.Description="Password" />
                                    <Button Grid.Column="1"
                                            Text="{Binding ShowPasswordText}"
                                            Style="{StaticResource GhostButton}"
                                            FontSize="{StaticResource FontSizeSmall}"
                                            Command="{Binding TogglePasswordVisibilityCommand}" />
                                </Grid>
                            </Border>
                            <Label Text="{Binding PasswordError}"
                                   Style="{StaticResource ErrorText}"
                                   IsVisible="{Binding HasPasswordError}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Confirm Password *" Style="{StaticResource InputLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Placeholder="Confirm password"
                                           Text="{Binding ConfirmPassword, Mode=TwoWay}"
                                           IsPassword="{Binding IsConfirmPasswordHidden}"
                                           SemanticProperties.Description="Confirm password" />
                                    <Button Grid.Column="1"
                                            Text="{Binding ShowConfirmPasswordText}"
                                            Style="{StaticResource GhostButton}"
                                            FontSize="{StaticResource FontSizeSmall}"
                                            Command="{Binding ToggleConfirmPasswordVisibilityCommand}" />
                                </Grid>
                            </Border>
                            <Label Text="{Binding ConfirmPasswordError}"
                                   Style="{StaticResource ErrorText}"
                                   IsVisible="{Binding HasConfirmPasswordError}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Style="{StaticResource FormActions}">
                            <Button Text="Back"
                                    Style="{StaticResource SecondaryButton}"
                                    Clicked="OnBackClicked"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                            <Button Grid.Column="1"
                                    Text="{Binding NextButtonText}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding NextCommand}" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="Step2Container" IsVisible="False" Spacing="{StaticResource Space4}">
                        <Label Text="Company information" Style="{StaticResource SectionTitle}" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Company Name *" Style="{StaticResource InputLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Placeholder="Your company name" Text="{Binding CompanyName, Mode=TwoWay}" />
                            </Border>
                            <Label Text="{Binding CompanyNameError}" Style="{StaticResource ErrorText}" IsVisible="{Binding HasCompanyNameError}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Business Type" Style="{StaticResource InputLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Picker Title="Select type" SelectedItem="{Binding BusinessType, Mode=TwoWay}">
                                    <Picker.Items>
                                        <x:String>Retail</x:String>
                                        <x:String>Wholesale</x:String>
                                        <x:String>Manufacturing</x:String>
                                        <x:String>Service</x:String>
                                        <x:String>Other</x:String>
                                    </Picker.Items>
                                </Picker>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Address" Style="{StaticResource InputLabel}" />
                            <Border Style="{StaticResource InputContainer}" MinimumHeightRequest="72">
                                <Editor Placeholder="Street address" Text="{Binding Address, Mode=TwoWay}" AutoSize="TextChanges" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="City" Style="{StaticResource InputLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Placeholder="City" Text="{Binding City, Mode=TwoWay}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="State" Style="{StaticResource InputLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Placeholder="State" Text="{Binding State, Mode=TwoWay}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="4">
                            <Label Text="GSTIN (optional)" Style="{StaticResource InputLabel}" />
                            <Border Style="{StaticResource InputContainer}">
                                <Entry Placeholder="GSTIN" Text="{Binding Gstin, Mode=TwoWay}" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Style="{StaticResource FormActions}">
                            <Button Text="Back"
                                    Style="{StaticResource SecondaryButton}"
                                    Clicked="OnBackClicked"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                            <Button Grid.Column="1"
                                    Text="{Binding NextButtonText}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding NextCommand}" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="Step3Container" IsVisible="False" Spacing="{StaticResource Space4}">
                        <Label Text="Subscription" Style="{StaticResource SectionTitle}" />
                        <Label Text="{Binding PlanDescription}" Style="{StaticResource SecondaryText}" />

                        <Border Style="{StaticResource AppCard}" Stroke="{StaticResource Primary300}">
                            <VerticalStackLayout Spacing="{StaticResource Space3}">
                                <Label Text="{Binding SelectedPlan}" Style="{StaticResource SectionTitle}" />
                                <Label Text="{Binding PlanPrice, StringFormat='Price: {0:C}'}" Style="{StaticResource SecondaryText}" />
                                <Label Text="{Binding TrialDays, StringFormat='Trial days: {0}'}" Style="{StaticResource SecondaryText}" />
                                <Label Text="{Binding CreditLimit, StringFormat='Credit limit: {0:N0}'}" Style="{StaticResource SecondaryText}" />
                                <Label Text="{Binding CreditsUsed, StringFormat='Credits used: {0:N0}'}" Style="{StaticResource SecondaryText}" />
                                <Label Text="{Binding RemainingCredits, StringFormat='Remaining credits: {0:N0}'}" Style="{StaticResource SecondaryText}" />
                                <Label Text="{Binding TrialStartDate, StringFormat='Trial start: {0:MMM d, yyyy}'}" Style="{StaticResource SecondaryText}" />
                                <Label Text="{Binding TrialEndDate, StringFormat='Trial end: {0:MMM d, yyyy}'}" Style="{StaticResource SecondaryText}" />
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Style="{StaticResource FormActions}">
                            <Button Text="Back"
                                    Style="{StaticResource SecondaryButton}"
                                    Clicked="OnBackClicked"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                            <Button Grid.Column="1"
                                    Text="{Binding NextButtonText}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding NextCommand}" />
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="Step4Container" IsVisible="False" Spacing="{StaticResource Space4}">
                        <Label Text="Review" Style="{StaticResource SectionTitle}" />

                        <Border Style="{StaticResource ListRow}">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="USER DETAILS" Style="{StaticResource CaptionText}" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="Edit" Style="{StaticResource GhostButton}" Command="{Binding EditUserCommand}" />
                                </Grid>
                                <Label Text="{Binding FirstName}" Style="{StaticResource BodyText}" />
                                <Label Text="{Binding Email}" Style="{StaticResource SecondaryText}" />
                                <Label Text="{Binding Phone}" Style="{StaticResource SecondaryText}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource ListRow}">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="COMPANY DETAILS" Style="{StaticResource CaptionText}" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="Edit" Style="{StaticResource GhostButton}" Command="{Binding EditCompanyCommand}" />
                                </Grid>
                                <Label Text="{Binding CompanyName}" Style="{StaticResource BodyText}" />
                                <Label Text="{Binding BusinessType}" Style="{StaticResource SecondaryText}" />
                                <Label Text="{Binding Address}" Style="{StaticResource SecondaryText}" />
                                <Label Text="{Binding City}" Style="{StaticResource SecondaryText}" />
                                <Label Text="{Binding State}" Style="{StaticResource SecondaryText}" />
                                <Label Text="{Binding Gstin}" Style="{StaticResource SecondaryText}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource ListRow}">
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="SUBSCRIPTION" Style="{StaticResource CaptionText}" VerticalOptions="Center" />
                                    <Button Grid.Column="1" Text="Edit" Style="{StaticResource GhostButton}" Command="{Binding EditSubscriptionCommand}" />
                                </Grid>
                                <Label Text="{Binding SelectedPlan}" Style="{StaticResource BodyText}" />
                                <Label Text="{Binding TrialDays, StringFormat='Trial days: {0}'}" Style="{StaticResource SecondaryText}" />
                                <Label Text="{Binding TrialStartDate, StringFormat='Start: {0:MMM d, yyyy}'}" Style="{StaticResource SecondaryText}" />
                                <Label Text="{Binding TrialEndDate, StringFormat='End: {0:MMM d, yyyy}'}" Style="{StaticResource SecondaryText}" />
                                <Label Text="{Binding CreditLimit, StringFormat='Credit limit: {0:N0}'}" Style="{StaticResource SecondaryText}" />
                            </VerticalStackLayout>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Style="{StaticResource FormActions}">
                            <Button Text="Back"
                                    Style="{StaticResource SecondaryButton}"
                                    Clicked="OnBackClicked"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
                            <Button Grid.Column="1"
                                    Text="{Binding NextButtonText}"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding NextCommand}" />
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>
        </ScrollView>
    </Grid>
</ContentPage>
