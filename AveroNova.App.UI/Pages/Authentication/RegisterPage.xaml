<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.Authentication.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:layout="clr-namespace:AveroNova.App.UI.Layout"
    xmlns:cards="clr-namespace:AveroNova.App.UI.Controls.Cards"
    xmlns:forms="clr-namespace:AveroNova.App.UI.Controls.Forms"
    xmlns:vm="clr-namespace:AveroNova.App.UI.ViewModels"
    x:DataType="vm:RegisterViewModel"
    x:Name="RegisterRoot"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasBackButton="False"
    SafeAreaEdges="Container"
    HideSoftInputOnTapped="True"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior IsVisible="False" IsEnabled="False" />
    </Shell.BackButtonBehavior>

    <ScrollView
        x:Name="PageScroll"
        Orientation="Vertical"
        HorizontalScrollBarVisibility="Never"
        VerticalScrollBarVisibility="Default">
        <VerticalStackLayout
            x:Name="FormHost"
            VerticalOptions="Start"
            HorizontalOptions="Center"
            Padding="{StaticResource PaddingLarge}"
            Spacing="0">

            <Border WidthRequest="56" HeightRequest="56"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    HorizontalOptions="Center">
                <Label Text="A" FontSize="28" FontAttributes="Bold"
                       TextColor="{StaticResource White}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Text="Create Account"
                   Style="{StaticResource PageTitle}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,20,0,4" />
            <Label Text="{Binding StepCaption}"
                   Style="{StaticResource SecondaryText}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,20" />

            <Grid x:Name="ProgressGrid"
                  layout:ResponsivePage.Ignore="True"
                  ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto"
                  HorizontalOptions="Fill"
                  Margin="0,0,0,24">
                <VerticalStackLayout Grid.Column="0" Spacing="6">
                    <Border x:Name="StepDot1" WidthRequest="32" HeightRequest="32"
                            StrokeThickness="0" StrokeShape="RoundRectangle 16"
                            HorizontalOptions="Center">
                        <Label x:Name="StepNum1" Text="1" FontSize="13" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </Border>
                    <Label x:Name="StepLabel1" Text="Step 1" FontSize="11" LineBreakMode="NoWrap" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <BoxView x:Name="StepLine1" Grid.Column="1" HeightRequest="2" VerticalOptions="Center" Margin="8,0,8,18" />
                <VerticalStackLayout Grid.Column="2" Spacing="6">
                    <Border x:Name="StepDot2" WidthRequest="32" HeightRequest="32"
                            StrokeThickness="0" StrokeShape="RoundRectangle 16"
                            HorizontalOptions="Center">
                        <Label x:Name="StepNum2" Text="2" FontSize="13" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </Border>
                    <Label x:Name="StepLabel2" Text="Step 2" FontSize="11" LineBreakMode="NoWrap" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <BoxView x:Name="StepLine2" Grid.Column="3" HeightRequest="2" VerticalOptions="Center" Margin="8,0,8,18" />
                <VerticalStackLayout Grid.Column="4" Spacing="6">
                    <Border x:Name="StepDot3" WidthRequest="32" HeightRequest="32"
                            StrokeThickness="0" StrokeShape="RoundRectangle 16"
                            HorizontalOptions="Center">
                        <Label x:Name="StepNum3" Text="3" FontSize="13" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </Border>
                    <Label x:Name="StepLabel3" Text="Step 3" FontSize="11" LineBreakMode="NoWrap" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
                <BoxView x:Name="StepLine3" Grid.Column="5" HeightRequest="2" VerticalOptions="Center" Margin="8,0,8,18" />
                <VerticalStackLayout Grid.Column="6" Spacing="6">
                    <Border x:Name="StepDot4" WidthRequest="32" HeightRequest="32"
                            StrokeThickness="0" StrokeShape="RoundRectangle 16"
                            HorizontalOptions="Center">
                        <Label x:Name="StepNum4" Text="4" FontSize="13" FontAttributes="Bold"
                               HorizontalOptions="Center" VerticalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </Border>
                    <Label x:Name="StepLabel4" Text="Step 4" FontSize="11" LineBreakMode="NoWrap" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>

            <Border IsVisible="{Binding HasSuccessMessage}"
                    BackgroundColor="{StaticResource SuccessBg}"
                    Stroke="{StaticResource SuccessBorder}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="14,10"
                    Margin="0,0,0,16">
                <Label Text="{Binding SuccessMessage}" FontSize="13" TextColor="{StaticResource SuccessText}" LineBreakMode="WordWrap" />
            </Border>

            <Border IsVisible="{Binding HasGeneralError}"
                    BackgroundColor="{StaticResource ErrorBg}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    Padding="14,10"
                    Margin="0,0,0,16">
                <Label Text="{Binding GeneralError}" FontSize="13" TextColor="{StaticResource ErrorColor}" LineBreakMode="WordWrap" />
            </Border>

            <Grid x:Name="Step1Grid" layout:ResponsivePage.Ignore="True" IsVisible="{Binding IsStep1}" ColumnDefinitions="*,*,*" ColumnSpacing="20" RowSpacing="8">
                <VerticalStackLayout x:Name="FullNameField" Grid.Column="0" Spacing="0">
                    <Label Text="Full Name *" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding FullName, Mode=TwoWay}"
                               Placeholder="Enter your full name"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="Full name" />
                    </Border>
                    <Label Text="{Binding FullNameError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasFullNameError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="EmailField" Grid.Column="1" Spacing="0">
                    <Label Text="Email *" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding Email, Mode=TwoWay}"
                               Placeholder="Enter email"
                               Keyboard="Email"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="Email address" />
                    </Border>
                    <Label Text="{Binding EmailError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasEmailError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="MobileField" Grid.Column="2" Spacing="0">
                    <Label Text="Mobile Number *" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding Mobile, Mode=TwoWay}"
                               Placeholder="Enter mobile number"
                               Keyboard="Telephone"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="Personal mobile number" />
                    </Border>
                    <Label Text="{Binding MobileError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasMobileError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="PersonalPinField" Grid.Row="1" Grid.Column="0" Spacing="0">
                    <Label Text="PIN / ZIP" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding PersonalPinCode, Mode=TwoWay}"
                               Placeholder="Enter PIN or ZIP"
                               Keyboard="Numeric"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="PIN or ZIP" />
                    </Border>
                    <Label Text="{Binding PersonalPinCodeError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasPersonalPinCodeError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="PasswordField" Grid.Row="1" Grid.Column="1" Spacing="0">
                    <Label Text="Password *" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding Password, Mode=TwoWay}"
                               Placeholder="Enter password"
                               IsPassword="{Binding IsPasswordHidden}"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="Password" />
                    </Border>
                    <Label Text="{Binding PasswordError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasPasswordError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="ConfirmField" Grid.Row="1" Grid.Column="2" Spacing="0">
                    <Label Text="Confirm Password" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding ConfirmPassword, Mode=TwoWay}"
                               Placeholder="Confirm password"
                               IsPassword="{Binding IsConfirmPasswordHidden}"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="Confirm password" />
                    </Border>
                    <Label Text="{Binding ConfirmPasswordError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasConfirmPasswordError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="PersonalAddressField" Grid.Row="2" Grid.Column="0" Spacing="0">
                    <Label Text="Address" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding PersonalAddress, Mode=TwoWay}"
                               Placeholder="Enter address"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="Address" />
                    </Border>
                    <Label Text="{Binding PersonalAddressError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasPersonalAddressError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="PersonalCityField" Grid.Row="2" Grid.Column="1" Spacing="0">
                    <Label Text="City" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding PersonalCity, Mode=TwoWay}"
                               Placeholder="Enter city"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="City" />
                    </Border>
                    <Label Text="{Binding PersonalCityError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasPersonalCityError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="PersonalStateField" Grid.Row="2" Grid.Column="2" Spacing="0">
                    <Label Text="State" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding PersonalState, Mode=TwoWay}"
                               Placeholder="Enter state"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="State" />
                    </Border>
                    <Label Text="{Binding PersonalStateError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasPersonalStateError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="PersonalCountryField" Grid.Row="3" Grid.Column="0" Spacing="0">
                    <Label Text="Country" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding PersonalCountry, Mode=TwoWay}"
                               Placeholder="Enter country"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="Country" />
                    </Border>
                    <Label Text="{Binding PersonalCountryError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasPersonalCountryError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>
            </Grid>

            <Grid x:Name="Step2Grid" layout:ResponsivePage.Ignore="True" IsVisible="{Binding IsStep2}" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="20" RowSpacing="8">
                <VerticalStackLayout x:Name="CompanyNameField" Grid.Column="0" Spacing="0">
                    <Label Text="Company Name *" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding CompanyName, Mode=TwoWay}"
                               Placeholder="Enter company name"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="Company name" />
                    </Border>
                    <Label Text="{Binding CompanyNameError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasCompanyNameError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="OwnerNameField" Grid.Column="1" Spacing="0">
                    <Label Text="Owner Name *" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding OwnerName, Mode=TwoWay}"
                               Placeholder="Enter owner name"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="Owner name" />
                    </Border>
                    <Label Text="{Binding OwnerNameError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasOwnerNameError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="GSTNumberField" Grid.Column="2" Spacing="0">
                    <Label Text="GST Number" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding GSTNumber, Mode=TwoWay}"
                               Placeholder="Enter GST number"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="GST number" />
                    </Border>
                    <Label Text="{Binding GSTNumberError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasGSTNumberError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="PANNumberField" Grid.Row="1" Grid.Column="0" Spacing="0">
                    <Label Text="PAN Number" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding PANNumber, Mode=TwoWay}"
                               Placeholder="Enter PAN number"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="PAN number" />
                    </Border>
                    <Label Text="{Binding PANNumberError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasPANNumberError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="CompanyEmailField" Grid.Row="1" Grid.Column="1" Spacing="0">
                    <Label Text="Email *" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding CompanyEmail, Mode=TwoWay}"
                               Placeholder="Enter email"
                               Keyboard="Email"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="Company email" />
                    </Border>
                    <Label Text="{Binding CompanyEmailError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasCompanyEmailError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="MobileNumberField" Grid.Row="1" Grid.Column="2" Spacing="0">
                    <Label Text="Mobile Number *" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding MobileNumber, Mode=TwoWay}"
                               Placeholder="Enter mobile number"
                               Keyboard="Telephone"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="Mobile number" />
                    </Border>
                    <Label Text="{Binding MobileNumberError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasMobileNumberError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="CountryField" Grid.Row="2" Grid.Column="0" Spacing="0">
                    <Label Text="Country" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding Country, Mode=TwoWay}"
                               Placeholder="Enter country"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="Country" />
                    </Border>
                    <Label Text="{Binding CountryError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasCountryError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="StateField" Grid.Row="2" Grid.Column="1" Spacing="0">
                    <Label Text="State" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding State, Mode=TwoWay}"
                               Placeholder="Enter state"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="State" />
                    </Border>
                    <Label Text="{Binding StateError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasStateError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="CityField" Grid.Row="2" Grid.Column="2" Spacing="0">
                    <Label Text="City" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding City, Mode=TwoWay}"
                               Placeholder="Enter city"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="City" />
                    </Border>
                    <Label Text="{Binding CityError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasCityError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="PinCodeField" Grid.Row="3" Grid.Column="0" Spacing="0">
                    <Label Text="Pin Code" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding PinCode, Mode=TwoWay}"
                               Placeholder="Enter pin code"
                               Keyboard="Numeric"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="Pin code" />
                    </Border>
                    <Label Text="{Binding PinCodeError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasPinCodeError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="AddressField" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Spacing="0">
                    <Label Text="Company Address" Style="{StaticResource InputLabel}" LineBreakMode="NoWrap" />
                    <Border Style="{StaticResource AuthenticationInput}" Margin="0,6,0,4">
                        <Entry Text="{Binding Address, Mode=TwoWay}"
                               Placeholder="Enter company address"
                               BackgroundColor="Transparent"
                               ClearButtonVisibility="Never"
                               ReturnType="Next"
                               SemanticProperties.Description="Company address" />
                    </Border>
                    <Label Text="{Binding AddressError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasAddressError}" LineBreakMode="WordWrap" Margin="0,0,0,12" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout x:Name="Step3Panel" IsVisible="{Binding IsStep3}" Spacing="16" Margin="0,0,0,8">
                <Label Text="Your company starts with a 15-day Free Trial. Paid plans are not available yet."
                       Style="{StaticResource SecondaryText}"
                       LineBreakMode="WordWrap" />
                <Label Text="{Binding PlanError}" FontSize="12" TextColor="{StaticResource ErrorColor}" IsVisible="{Binding HasPlanError}" LineBreakMode="WordWrap" />
                <Grid x:Name="PlanCardsGrid"
                      layout:ResponsivePage.Ignore="True"
                      ColumnDefinitions="*,*,*,*"
                      ColumnSpacing="12"
                      RowSpacing="12"
                      HorizontalOptions="Fill"
                      BindableLayout.ItemsSource="{Binding Plans}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:RegisterPlanOption">
                            <cards:SubscriptionPlanCard
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </Grid>
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="Step4Panel" IsVisible="{Binding IsStep4}" Spacing="16" Margin="0,0,0,8">
                <Border x:Name="UnderReviewCard" Style="{StaticResource AppCard}" Padding="16">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Under Review" FontSize="18" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        <Label Text="Please confirm your personal, company, and subscription details, then create your account."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"
                               LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Grid x:Name="ReviewCardsGrid"
                      layout:ResponsivePage.Ignore="True"
                      ColumnDefinitions="*,*,*,*"
                      ColumnSpacing="12"
                      RowSpacing="12"
                      HorizontalOptions="Fill">
                    <Border x:Name="PersonalReviewCard" Style="{StaticResource ReviewCard}">
                        <Grid RowDefinitions="Auto,*" RowSpacing="12" VerticalOptions="Fill">
                            <Label Text="Personal Information" Style="{StaticResource CardTitle}" LineBreakMode="WordWrap" />
                            <VerticalStackLayout Grid.Row="1" Spacing="8" VerticalOptions="Start">
                                <forms:ReviewFieldRow LabelText="Full Name" ValueText="{Binding FullName}" />
                                <forms:ReviewFieldRow LabelText="Email" ValueText="{Binding Email}" />
                                <forms:ReviewFieldRow LabelText="Mobile Number" ValueText="{Binding Mobile}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border x:Name="CompanyReviewCard" Style="{StaticResource ReviewCard}">
                        <Grid RowDefinitions="Auto,*" RowSpacing="12" VerticalOptions="Fill">
                            <Label Text="Company Details" Style="{StaticResource CardTitle}" LineBreakMode="WordWrap" />
                            <VerticalStackLayout Grid.Row="1" Spacing="8" VerticalOptions="Start">
                                <forms:ReviewFieldRow LabelText="Company Name" ValueText="{Binding CompanyName}" />
                                <forms:ReviewFieldRow LabelText="Owner Name" ValueText="{Binding OwnerName}" />
                                <forms:ReviewFieldRow LabelText="Email" ValueText="{Binding CompanyEmail}" />
                                <forms:ReviewFieldRow LabelText="Mobile Number" ValueText="{Binding MobileNumber}" />
                                <forms:ReviewFieldRow LabelText="GST Number" ValueText="{Binding GSTNumber}"
                                                     IsVisible="{Binding GSTNumber, Converter={StaticResource StringNotEmptyConverter}}" />
                                <forms:ReviewFieldRow LabelText="PAN Number" ValueText="{Binding PANNumber}"
                                                     IsVisible="{Binding PANNumber, Converter={StaticResource StringNotEmptyConverter}}" />
                                <forms:ReviewFieldRow LabelText="Country" ValueText="{Binding Country}"
                                                     IsVisible="{Binding Country, Converter={StaticResource StringNotEmptyConverter}}" />
                                <forms:ReviewFieldRow LabelText="State" ValueText="{Binding State}"
                                                     IsVisible="{Binding State, Converter={StaticResource StringNotEmptyConverter}}" />
                                <forms:ReviewFieldRow LabelText="City" ValueText="{Binding City}"
                                                     IsVisible="{Binding City, Converter={StaticResource StringNotEmptyConverter}}" />
                                <forms:ReviewFieldRow LabelText="Pin Code" ValueText="{Binding PinCode}"
                                                     IsVisible="{Binding PinCode, Converter={StaticResource StringNotEmptyConverter}}" />
                                <forms:ReviewFieldRow LabelText="Company Address" ValueText="{Binding Address}"
                                                     IsVisible="{Binding Address, Converter={StaticResource StringNotEmptyConverter}}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border x:Name="PlanReviewCard" Style="{StaticResource ReviewCard}">
                        <Grid RowDefinitions="Auto,*" RowSpacing="12" VerticalOptions="Fill">
                            <Label Text="Subscription Plan" Style="{StaticResource CardTitle}" LineBreakMode="WordWrap" />
                            <VerticalStackLayout Grid.Row="1" Spacing="8" VerticalOptions="Start">
                                <forms:ReviewFieldRow LabelText="Plan" ValueText="{Binding SelectedPlanName}" />
                                <forms:ReviewFieldRow LabelText="Price" ValueText="{Binding SelectedPlanPrice}" />
                                <forms:ReviewFieldRow LabelText="Validity" ValueText="{Binding SelectedPlanValidity}" />
                                <forms:ReviewFieldRow LabelText="Status" ValueText="Selected" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border x:Name="AdditionalReviewCard"
                            Style="{StaticResource ReviewCard}"
                            IsVisible="{Binding HasAdditionalReviewDetails}">
                        <Grid RowDefinitions="Auto,*" RowSpacing="12" VerticalOptions="Fill">
                            <Label Text="Additional Details" Style="{StaticResource CardTitle}" LineBreakMode="WordWrap" />
                            <VerticalStackLayout Grid.Row="1" Spacing="8" VerticalOptions="Start">
                                <forms:ReviewFieldRow LabelText="Address" ValueText="{Binding PersonalAddress}"
                                                     IsVisible="{Binding PersonalAddress, Converter={StaticResource StringNotEmptyConverter}}" />
                                <forms:ReviewFieldRow LabelText="City" ValueText="{Binding PersonalCity}"
                                                     IsVisible="{Binding PersonalCity, Converter={StaticResource StringNotEmptyConverter}}" />
                                <forms:ReviewFieldRow LabelText="State" ValueText="{Binding PersonalState}"
                                                     IsVisible="{Binding PersonalState, Converter={StaticResource StringNotEmptyConverter}}" />
                                <forms:ReviewFieldRow LabelText="Country" ValueText="{Binding PersonalCountry}"
                                                     IsVisible="{Binding PersonalCountry, Converter={StaticResource StringNotEmptyConverter}}" />
                                <forms:ReviewFieldRow LabelText="Pin Code" ValueText="{Binding PersonalPinCode}"
                                                     IsVisible="{Binding PersonalPinCode, Converter={StaticResource StringNotEmptyConverter}}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </Grid>
            </VerticalStackLayout>

            <Grid x:Name="ActionGrid"
                  layout:ResponsivePage.Ignore="True"
                  Margin="0,16,0,24">
                <Grid x:Name="ActionButtonsHost"
                      HorizontalOptions="End"
                      VerticalOptions="Center"
                      ColumnDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="8">
                    <Button x:Name="BackButton"
                            Grid.Column="0"
                            Text="Back"
                            Style="{StaticResource WizardSecondaryButton}"
                            Clicked="OnBackClicked"
                            IsVisible="{Binding IsBackVisible}"
                            IsEnabled="{Binding IsInteractionEnabled}" />
                    <ActivityIndicator x:Name="ActionSpinner"
                                       Grid.Column="1"
                                       WidthRequest="22"
                                       HeightRequest="22"
                                       Color="{StaticResource PrimaryColor}"
                                       IsRunning="False"
                                       IsVisible="False"
                                       VerticalOptions="Center" />
                    <Button x:Name="PrimaryActionButton"
                            Grid.Column="2"
                            Text="{Binding PrimaryActionText}"
                            Style="{StaticResource WizardPrimaryButton}"
                            Clicked="OnPrimaryActionClicked"
                            IsEnabled="{Binding IsInteractionEnabled}" />
                </Grid>
            </Grid>

            <HorizontalStackLayout
                IsVisible="{Binding IsStep1}"
                HorizontalOptions="Center"
                Spacing="4"
                Margin="0,28,0,0">
                <Label Text="Already have an account?"
                       FontSize="13"
                       TextColor="{StaticResource TextSecondary}" />
                <Label Text="Login"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryColor}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLoginTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
