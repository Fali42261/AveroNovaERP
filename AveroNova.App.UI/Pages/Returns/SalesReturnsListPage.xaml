<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="AveroNova.App.UI.Pages.Returns.SalesReturnsListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="20,14"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}" StrokeThickness="1">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Sales Returns" FontSize="20" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" VerticalOptions="Center"/>
                <Button Grid.Column="1" Text="+ New Return" Style="{StaticResource PrimaryButton}"
                        HeightRequest="40" FontSize="13" Clicked="OnNewClicked"/>
            </Grid>
        </Border>
        <RefreshView Grid.Row="1" x:Name="Refresher" Refreshing="OnRefreshing">
            <ScrollView><VerticalStackLayout Padding="16,12" Spacing="10" x:Name="List"/></ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
