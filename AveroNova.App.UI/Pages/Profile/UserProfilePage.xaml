<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.Profile.UserProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="24,20" Spacing="16" MaximumWidthRequest="640">
            <Label
                Text="Profile"
                FontSize="20"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
            <Label
                Text="Signed-in user account"
                FontSize="12"
                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

            <Border
                Style="{StaticResource AppCard}"
                Padding="20">
                <Grid ColumnDefinitions="56,*" ColumnSpacing="14">
                    <Border
                        WidthRequest="56"
                        HeightRequest="56"
                        BackgroundColor="{StaticResource Primary100}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 28">
                        <Label
                            x:Name="LblInitials"
                            Text="SW"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="{StaticResource PrimaryColor}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                Text="Name"
                                FontSize="11"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label
                                x:Name="LblName"
                                Text=""
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2">
                            <Label
                                Text="Email"
                                FontSize="11"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                            <Label
                                x:Name="LblEmail"
                                Text=""
                                FontSize="14"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
