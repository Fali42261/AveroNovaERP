<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.Company.CompanyFormPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Padding="20,14"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"
                StrokeThickness="1">
            <Grid ColumnDefinitions="Auto,*">
                <Button Text="&#x2190;" Style="{StaticResource GhostButton}" Padding="0"
                        WidthRequest="40" Clicked="OnBackClicked"/>
                <Label Grid.Column="1" x:Name="LblTitle" Text="Add Company"
                       FontSize="18" FontAttributes="Bold" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
            </Grid>
        </Border>

        <!-- Form -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,16" Spacing="16">

                <Border Style="{StaticResource AppCard}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Company Information" FontSize="14" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                        <BoxView Style="{StaticResource Divider}"/>

                        <Label Text="Company Name *" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}">
                            <Entry x:Name="EntryName" Placeholder="Enter company name"/>
                        </Border>

                        <Label Text="Email Address" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}">
                            <Entry x:Name="EntryEmail" Placeholder="company@email.com" Keyboard="Email"/>
                        </Border>

                        <Label Text="Phone" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}">
                            <Entry x:Name="EntryPhone" Placeholder="+1 555-0000" Keyboard="Telephone"/>
                        </Border>

                        <Label Text="Website" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}">
                            <Entry x:Name="EntryWebsite" Placeholder="https://www.company.com" Keyboard="Url"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AppCard}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Address" FontSize="14" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                        <BoxView Style="{StaticResource Divider}"/>

                        <Label Text="Address" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}">
                            <Entry x:Name="EntryAddress" Placeholder="Street address"/>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="City" Style="{StaticResource InputLabel}"/>
                                <Border Style="{StaticResource InputContainer}">
                                    <Entry x:Name="EntryCity" Placeholder="City"/>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Country" Style="{StaticResource InputLabel}"/>
                                <Border Style="{StaticResource InputContainer}">
                                    <Entry x:Name="EntryCountry" Placeholder="Country"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AppCard}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Tax &amp; Finance" FontSize="14" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                        <BoxView Style="{StaticResource Divider}"/>

                        <Label Text="Tax Number" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}">
                            <Entry x:Name="EntryTax" Placeholder="TAX-000000"/>
                        </Border>

                        <Label Text="Registration Number" Style="{StaticResource InputLabel}"/>
                        <Border Style="{StaticResource InputContainer}">
                            <Entry x:Name="EntryRegNo" Placeholder="REG-000000"/>
                        </Border>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Currency" Style="{StaticResource InputLabel}"/>
                                <Border Style="{StaticResource InputContainer}">
                                    <Entry x:Name="EntryCurrency" Placeholder="USD"/>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Invoice Prefix" Style="{StaticResource InputLabel}"/>
                                <Border Style="{StaticResource InputContainer}">
                                    <Entry x:Name="EntryInvPrefix" Placeholder="INV"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Error -->
                <Border x:Name="ErrorBanner" IsVisible="False"
                        BackgroundColor="{StaticResource ErrorBg}"
                        Stroke="{StaticResource ErrorBorder}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 10" Padding="14,10">
                    <Label x:Name="LblError" FontSize="13" TextColor="{StaticResource ErrorText}" LineBreakMode="WordWrap"/>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer buttons -->
        <Border Grid.Row="2" Padding="20,12"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"
                StrokeThickness="1">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Cancel" Style="{StaticResource SecondaryButton}" Clicked="OnBackClicked"/>
                <Button Grid.Column="1" Text="Save Company" Style="{StaticResource PrimaryButton}"
                        Clicked="OnSaveClicked"/>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
