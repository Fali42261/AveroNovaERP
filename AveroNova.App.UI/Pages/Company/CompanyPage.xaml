<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.Company.CompanyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:state="clr-namespace:AveroNova.App.UI.Controls.State"
    xmlns:forms="clr-namespace:AveroNova.App.UI.Controls.Forms"
    xmlns:vm="clr-namespace:AveroNova.App.UI.ViewModels"
    x:DataType="vm:CompanyPageViewModel"
    Title=""
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">

    <Grid
        x:Name="Root"
        SizeChanged="OnRootSizeChanged"
        RowDefinitions="Auto,*"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

        <Grid
            x:Name="HeaderBar"
            Grid.Row="0"
            Padding="20,16,20,8"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12"
            RowSpacing="8"
            HorizontalOptions="Fill">
                <VerticalStackLayout
                    x:Name="HeaderTitle"
                    Spacing="2"
                    VerticalOptions="Center"
                    HorizontalOptions="Fill">
                    <Label
                        Text="Current company profile"
                        FontSize="16"
                        FontAttributes="Bold"
                        LineBreakMode="TailTruncation"
                        AutomationId="CompanyProfileHeading"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label
                        Text="{Binding DisplayCompanyName}"
                        Style="{StaticResource SecondaryText}"
                        LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <HorizontalStackLayout
                    x:Name="HeaderActions"
                    Grid.Column="1"
                    Spacing="8"
                    VerticalOptions="Center"
                    HorizontalOptions="End">

                    <Button
                        Text="Edit Company"
                        Style="{StaticResource SmallButton}"
                        HeightRequest="36"
                        MinimumWidthRequest="108"
                        MinimumHeightRequest="36"
                        Padding="14,0"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Command="{Binding BeginEditCommand}"
                        IsVisible="{Binding ShowEditButton}" />

                    <Button
                        Text="Cancel"
                        Style="{StaticResource SmallSecondaryButton}"
                        HeightRequest="36"
                        MinimumWidthRequest="88"
                        MinimumHeightRequest="36"
                        Padding="14,0"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Command="{Binding CancelEditCommand}"
                        IsVisible="{Binding ShowEditFooter}"
                        IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}" />

                    <Grid
                        HeightRequest="36"
                        MinimumWidthRequest="120"
                        IsVisible="{Binding ShowEditFooter}"
                        VerticalOptions="Center">
                        <Button
                            Text="{Binding SaveButtonText}"
                            Style="{StaticResource SmallButton}"
                            HeightRequest="36"
                            MinimumWidthRequest="120"
                            MinimumHeightRequest="36"
                            Padding="14,0"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding CanPressSave}" />
                        <ActivityIndicator
                            IsVisible="{Binding IsSaving}"
                            IsRunning="{Binding IsSaving}"
                            Color="{StaticResource White}"
                            WidthRequest="18"
                            HeightRequest="18"
                            HorizontalOptions="End"
                            VerticalOptions="Center"
                            Margin="0,0,8,0"
                            InputTransparent="True" />
                    </Grid>
                </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="1" HorizontalOptions="Fill">

            <ScrollView IsVisible="{Binding ShowLoading}" HorizontalOptions="Fill">
                <VerticalStackLayout
                    Padding="20,16,20,24"
                    Spacing="16"
                    HorizontalOptions="Fill">
                    <state:LoadingView Message="Loading company details..." />
                    <Grid
                        x:Name="LoadingGrid"
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="12"
                        RowSpacing="12"
                        HorizontalOptions="Fill">
                        <Border Style="{StaticResource AppCard}" Padding="14,10" MinimumWidthRequest="0">
                            <BoxView HeightRequest="14" CornerRadius="4"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource SurfaceColorDark}}" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource AppCard}" Padding="14,10" MinimumWidthRequest="0">
                            <BoxView HeightRequest="14" CornerRadius="4"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource SurfaceColorDark}}" />
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource AppCard}" Padding="14,10" MinimumWidthRequest="0">
                            <BoxView HeightRequest="14" CornerRadius="4"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource SurfaceColorDark}}" />
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource AppCard}" Padding="14,10" MinimumWidthRequest="0">
                            <BoxView HeightRequest="14" CornerRadius="4"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource SurfaceColorDark}}" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AppCard}" Padding="14,10" MinimumWidthRequest="0">
                            <BoxView HeightRequest="14" CornerRadius="4"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource SurfaceColorDark}}" />
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource AppCard}" Padding="14,10" MinimumWidthRequest="0">
                            <BoxView HeightRequest="14" CornerRadius="4"
                                     BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource SurfaceColorDark}}" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>

            <state:ErrorView
                x:Name="ErrorState"
                IsVisible="{Binding ShowError}"
                Title="Unable to load company details."
                Message="Unable to load company details." />

            <ScrollView IsVisible="{Binding ShowContent}" HorizontalOptions="Fill">
                <VerticalStackLayout
                    Padding="20,16,20,24"
                    Spacing="16"
                    HorizontalOptions="Fill">

                    <Grid
                        x:Name="ViewFieldsGrid"
                        IsVisible="{Binding ShowViewMode}"
                        ColumnDefinitions="*,*,*"
                        ColumnSpacing="12"
                        RowSpacing="12"
                        HorizontalOptions="Fill">

                        <forms:CompactFieldCard LabelText="Company Name" ValueText="{Binding DisplayCompanyName}" />
                        <forms:CompactFieldCard LabelText="Owner Name" ValueText="{Binding DisplayOwnerName}" />
                        <forms:CompactFieldCard LabelText="Email" ValueText="{Binding DisplayEmail}" />
                        <forms:CompactFieldCard LabelText="Mobile" ValueText="{Binding DisplayMobileNumber}" />
                        <forms:CompactFieldCard LabelText="GST Number" ValueText="{Binding DisplayGstNumber}" />
                        <forms:CompactFieldCard LabelText="PAN Number" ValueText="{Binding DisplayPanNumber}" />
                        <forms:CompactFieldCard LabelText="Address" ValueText="{Binding DisplayAddress}" />
                        <forms:CompactFieldCard LabelText="City" ValueText="{Binding DisplayCity}" />
                        <forms:CompactFieldCard LabelText="State" ValueText="{Binding DisplayState}" />
                        <forms:CompactFieldCard LabelText="Country" ValueText="{Binding DisplayCountry}" />
                        <forms:CompactFieldCard LabelText="PIN / ZIP" ValueText="{Binding DisplayPinCode}" />
                        <forms:CompactFieldCard LabelText="Plan" ValueText="{Binding PlanName}" />
                        <forms:CompactFieldCard LabelText="Price" ValueText="{Binding DisplayPrice}" />
                        <forms:CompactFieldCard LabelText="Validity" ValueText="{Binding DisplayValidity}" />
                        <forms:CompactFieldCard LabelText="Status" ValueText="{Binding SubscriptionStatus}" />
                        <forms:CompactFieldCard LabelText="Start Date" ValueText="{Binding DisplayStartDate}" />
                        <forms:CompactFieldCard LabelText="Expiry Date" ValueText="{Binding DisplayExpiryDate}" />
                    </Grid>

                    <VerticalStackLayout
                        Spacing="16"
                        IsVisible="{Binding ShowEditMode}"
                        HorizontalOptions="Fill">

                        <Grid
                            x:Name="EditFieldsGrid"
                            ColumnDefinitions="*,*,*"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="16"
                            RowSpacing="16"
                            HorizontalOptions="Fill">

                            <Border Style="{StaticResource AppCard}" VerticalOptions="Fill" HorizontalOptions="Fill" MinimumWidthRequest="0">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Company Name *" Style="{StaticResource InputLabel}" />
                                    <Border
                                        Style="{StaticResource InputContainer}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource SurfaceColorDark}}">
                                        <Entry
                                            Text="{Binding EditCompanyName, Mode=OneWay}"
                                            IsReadOnly="True"
                                            IsEnabled="False"
                                            MaxLength="200"
                                            AutomationId="CompanyNameReadOnly"
                                            SemanticProperties.Description="Company name, read only" />
                                    </Border>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource AppCard}" VerticalOptions="Fill" HorizontalOptions="Fill" MinimumWidthRequest="0">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Owner Name *" Style="{StaticResource InputLabel}" />
                                    <Border Style="{StaticResource InputContainer}">
                                        <Entry
                                            Text="{Binding EditOwnerName}"
                                            Placeholder="Enter owner name"
                                            MaxLength="150"
                                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                                            SemanticProperties.Description="Owner name" />
                                    </Border>
                                    <Label
                                        Text="{Binding OwnerNameError}"
                                        Style="{StaticResource ErrorText}"
                                        IsVisible="{Binding HasOwnerNameError}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource AppCard}" VerticalOptions="Fill" HorizontalOptions="Fill" MinimumWidthRequest="0">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="GST Number" Style="{StaticResource InputLabel}" />
                                    <Border Style="{StaticResource InputContainer}">
                                        <Entry
                                            Text="{Binding EditGstNumber}"
                                            Placeholder="Enter GST number"
                                            MaxLength="20"
                                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                                            SemanticProperties.Description="GST number" />
                                    </Border>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource AppCard}" VerticalOptions="Fill" HorizontalOptions="Fill" MinimumWidthRequest="0">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="PAN Number" Style="{StaticResource InputLabel}" />
                                    <Border Style="{StaticResource InputContainer}">
                                        <Entry
                                            Text="{Binding EditPanNumber}"
                                            Placeholder="Enter PAN number"
                                            MaxLength="20"
                                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                                            SemanticProperties.Description="PAN number" />
                                    </Border>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AppCard}" VerticalOptions="Fill" HorizontalOptions="Fill" MinimumWidthRequest="0">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Email *" Style="{StaticResource InputLabel}" />
                                    <Border Style="{StaticResource InputContainer}">
                                        <Entry
                                            Text="{Binding EditEmail}"
                                            Placeholder="Enter email"
                                            Keyboard="Email"
                                            MaxLength="150"
                                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                                            SemanticProperties.Description="Email" />
                                    </Border>
                                    <Label
                                        Text="{Binding EmailError}"
                                        Style="{StaticResource ErrorText}"
                                        IsVisible="{Binding HasEmailError}" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource AppCard}" VerticalOptions="Fill" HorizontalOptions="Fill" MinimumWidthRequest="0">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Mobile Number *" Style="{StaticResource InputLabel}" />
                                    <Border Style="{StaticResource InputContainer}">
                                        <Entry
                                            Text="{Binding EditMobileNumber}"
                                            Placeholder="Enter mobile number"
                                            Keyboard="Telephone"
                                            MaxLength="15"
                                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                                            SemanticProperties.Description="Mobile number" />
                                    </Border>
                                    <Label
                                        Text="{Binding MobileNumberError}"
                                        Style="{StaticResource ErrorText}"
                                        IsVisible="{Binding HasMobileNumberError}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <Label Text="Address" Style="{StaticResource SectionTitle}" />

                        <Grid
                            x:Name="EditAddressGrid"
                            ColumnDefinitions="*,*,*"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="16"
                            RowSpacing="16"
                            HorizontalOptions="Fill">

                            <Border Style="{StaticResource AppCard}" VerticalOptions="Fill" HorizontalOptions="Fill" MinimumWidthRequest="0">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Address" Style="{StaticResource InputLabel}" />
                                    <Border Style="{StaticResource InputContainer}" HeightRequest="88" Padding="14,10" VerticalOptions="Start">
                                        <Editor
                                            Text="{Binding EditAddress}"
                                            Placeholder="Enter company address"
                                            AutoSize="TextChanges"
                                            MaxLength="500"
                                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                                            SemanticProperties.Description="Address" />
                                    </Border>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource AppCard}" VerticalOptions="Fill" HorizontalOptions="Fill" MinimumWidthRequest="0">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="City" Style="{StaticResource InputLabel}" />
                                    <Border Style="{StaticResource InputContainer}">
                                        <Entry
                                            Text="{Binding EditCity}"
                                            Placeholder="Enter city"
                                            MaxLength="100"
                                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                                            SemanticProperties.Description="City" />
                                    </Border>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource AppCard}" VerticalOptions="Fill" HorizontalOptions="Fill" MinimumWidthRequest="0">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="State" Style="{StaticResource InputLabel}" />
                                    <Border Style="{StaticResource InputContainer}">
                                        <Entry
                                            Text="{Binding EditState}"
                                            Placeholder="Enter state"
                                            MaxLength="100"
                                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                                            SemanticProperties.Description="State" />
                                    </Border>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource AppCard}" VerticalOptions="Fill" HorizontalOptions="Fill" MinimumWidthRequest="0">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Country" Style="{StaticResource InputLabel}" />
                                    <Border Style="{StaticResource InputContainer}">
                                        <Entry
                                            Text="{Binding EditCountry}"
                                            Placeholder="Enter country"
                                            MaxLength="100"
                                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                                            SemanticProperties.Description="Country" />
                                    </Border>
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AppCard}" VerticalOptions="Fill" HorizontalOptions="Fill" MinimumWidthRequest="0">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="PIN / ZIP" Style="{StaticResource InputLabel}" />
                                    <Border Style="{StaticResource InputContainer}">
                                        <Entry
                                            Text="{Binding EditPinCode}"
                                            Placeholder="Enter pin code"
                                            MaxLength="10"
                                            Keyboard="Numeric"
                                            IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}"
                                            SemanticProperties.Description="PIN or ZIP" />
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
