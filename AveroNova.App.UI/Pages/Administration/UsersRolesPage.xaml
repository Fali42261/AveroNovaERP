<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.Administration.UsersRolesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">

    <Grid RowDefinitions="Auto,*">
        <Border
            Padding="20,14"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"
            StrokeThickness="1">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label
                        Text="Users &amp; Roles"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label
                        Text="Manage users and the permissions assigned through roles"
                        FontSize="12"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                </VerticalStackLayout>
                <Button
                    x:Name="BtnUsers"
                    Grid.Column="1"
                    Text="Users"
                    Style="{StaticResource PrimaryButton}"
                    HeightRequest="40"
                    FontSize="13"
                    Clicked="OnUsersTabClicked" />
                <Button
                    x:Name="BtnRoles"
                    Grid.Column="2"
                    Text="Roles"
                    Style="{StaticResource SmallSecondaryButton}"
                    HeightRequest="40"
                    FontSize="13"
                    Clicked="OnRolesTabClicked" />
            </Grid>
        </Border>

        <ContentView
            x:Name="TabHost"
            Grid.Row="1" />
    </Grid>
</ContentPage>
