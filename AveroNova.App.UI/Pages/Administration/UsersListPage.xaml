<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="AveroNova.App.UI.Pages.Administration.UsersListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundColor}, Dark={StaticResource BackgroundColorDark}}">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <Border Grid.Row="0" Padding="20,14"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"
                StrokeThickness="1">
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Users" FontSize="20" FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"/>
                    <Label x:Name="LblCount" Text="0 users" FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}"/>
                </VerticalStackLayout>
                <Button x:Name="BtnAdd" Grid.Column="1"
                        Text="Add"
                        Style="{StaticResource PrimaryButton}"
                        HeightRequest="40"
                        FontSize="13"
                        Clicked="OnAddClicked"/>
            </Grid>
        </Border>

        <Border x:Name="PlanLimitBanner" Grid.Row="1" IsVisible="False" Padding="14,10"
                BackgroundColor="#FFFBEB" Stroke="#FDE68A" StrokeThickness="1">
            <Label x:Name="LblPlanLimit" Text="Free plan user limit reached."
                   FontSize="12" TextColor="#92400E" LineBreakMode="WordWrap"/>
        </Border>

        <Border Grid.Row="2" Padding="16,10"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceColor}, Dark={StaticResource SurfaceColorDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderColor}, Dark={StaticResource BorderColorDark}}"
                StrokeThickness="1">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Border Style="{StaticResource InputContainer}" HeightRequest="40">
                    <SearchBar x:Name="SearchBar" Placeholder="Search users..."
                               TextChanged="OnSearchChanged" BackgroundColor="Transparent"/>
                </Border>
                <Button Grid.Column="1" Text="{StaticResource IconFilter}" Style="{StaticResource SmallSecondaryButton}" Clicked="OnFilterClicked"/>
                <Button Grid.Column="2" Text="{StaticResource IconRefresh}" Style="{StaticResource SmallSecondaryButton}" Clicked="OnRefreshClicked"/>
            </Grid>
        </Border>

        <RefreshView Grid.Row="3" x:Name="Refresher" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="16,12" Spacing="10" x:Name="UserList"/>
            </ScrollView>
        </RefreshView>

    </Grid>
</ContentPage>
