{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Data/AveroNovaDev.db"
  },
  "OfflineSession": {
    "OfflineSessionMaxAgeHours": 336
  },
  "Jwt": {
    "Issuer": "AveroNova",
    "Audience": "AveroNova.Clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "SigningKey": ""
  },
  "AuthSecurity": {
    "MaxFailedAttempts": 8,
    "LockoutMinutes": 15
  }
}
